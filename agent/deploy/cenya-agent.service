# El agente de Cenya como servicio de systemd. Lo instala install.sh (no hay que
# copiarlo a mano): sudo sh install.sh cenya://portal/CODIGO
#
# Corre con su propio usuario sin privilegios (cenya-agent) y guarda su estado
# --el token, su clave, sus ajustes, su cola-- en /var/lib/cenya-agent, que
# systemd crea para ese usuario (StateDirectory) con 0700. El token no está en
# este fichero ni en ninguna variable: lo canjea `cenya-agent enroll` y lo
# guarda el propio agente, protegido.

[Unit]
Description=Cenya discovery agent
Documentation=https://github.com/cenya-io/cenya-agent
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=cenya-agent
Group=cenya-agent
ExecStart=/opt/cenya-agent/current/bin/cenya-agent
Environment=CENYA_STATE_DIR=/var/lib/cenya-agent
Environment=HOME=/var/lib/cenya-agent
StateDirectory=cenya-agent
StateDirectoryMode=0700
Restart=on-failure
RestartSec=30

# El barrido hace ping con el del sistema, y un socket ICMP necesita
# CAP_NET_RAW. Con NoNewPrivileges las capacidades de fichero de /usr/bin/ping
# no cuentan, así que se le da al proceso: esta y ninguna otra.
AmbientCapabilities=CAP_NET_RAW
CapabilityBoundingSet=CAP_NET_RAW

# Endurecimiento: nada de esto le hace falta al agente para barrer y empujar.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
