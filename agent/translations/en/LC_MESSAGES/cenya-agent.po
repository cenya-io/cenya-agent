msgstr[1] "%(n)d new findings"

#: agent/__main__.py:42 agent/runtime.py:91 agent/status.py:439
#, python-format
msgid "%(n)d ya conocido."
msgid_plural "%(n)d ya conocidos."
msgstr[0] "%(n)d already known."
msgstr[1] "%(n)d already known."

#: agent/__main__.py:45
#, python-format
msgid "%(n)d envío"
msgid_plural "%(n)d envíos"
msgstr[0] "%(n)d batch"
msgstr[1] "%(n)d batches"

#: agent/__main__.py:46
#, python-format
msgid "[agente] Barrido enviado en %(batches)s: %(created)s, %(refreshed)s"
msgstr "[agent] Sweep sent in %(batches)s: %(created)s, %(refreshed)s"

#: agent/__main__.py:47
#, python-format
msgid "[agente] Barrido enviado: %(created)s, %(refreshed)s"
msgstr "[agent] Sweep sent: %(created)s, %(refreshed)s"

#: agent/__main__.py:68 agent/control.py:736 agent/runtime.py:758
#, python-format
msgid "Error inesperado: %(error)s"
msgstr "Unexpected error: %(error)s"

#: agent/__main__.py:287 agent/__main__.py:412 agent/__main__.py:419 agent/control.py:712 agent/runtime.py:519
#, python-format
msgid "[agente] %(error)s"
msgstr "[agent] %(error)s"

#: agent/__main__.py:325
msgid "[agente] Detenido."
msgstr "[agent] Stopped."

#: agent/__main__.py:350
msgid "[agente] Sin enrolar: esperando una conexión."
msgstr "[agent] Not enrolled: waiting for a connection."

#: agent/__main__.py:351
msgid "[agente] Esperando a que se conecte este equipo (cenya-agent connect <cadena>, o la aplicación Cenya Agent)."
msgstr "[agent] Waiting for this machine to be connected (cenya-agent connect <string>, or the Cenya Agent application)."

#: agent/__main__.py:384
#, python-format
msgid "[agente] Conectado a %(url)s con el protocolo 2."
msgstr "[agent] Connected to %(url)s using protocol 2."

#: agent/__main__.py:388
msgid "[agente] El servidor solo habla el protocolo 1: se sigue con el bucle de siempre."
msgstr "[agent] The server only speaks protocol 1: carrying on with the usual loop."

#: agent/__main__.py:403
#, python-format
msgid "[agente] Empujando a %(url)s cada ~%(seconds)d s."
msgstr "[agent] Pushing to %(url)s every ~%(seconds)d s."

#: agent/approvals.py:142
#, python-format
msgid "[agente] El agente «%(name)s» pide las credenciales de este perfil: hay que permitirlo o rechazarlo en la ventana de Cenya Agent de este equipo."
msgstr "[agent] The agent “%(name)s” is asking for this profile's credentials: allow or refuse it in the Cenya Agent window on this machine."

#: agent/client.py:167
msgid "La dirección del proxy no es válida: revisa el ajuste «proxy» (settings.json o CENYA_PROXY). No se muestra aquí porque puede llevar una contraseña."
msgstr "The proxy address is not valid: check the «proxy» setting (settings.json or CENYA_PROXY). It is not shown here because it may contain a password."

#: agent/client.py:404
#, python-format
msgid "Lo leído de NetBox ocupa %(mb)s MB y el servidor admite %(max)s MB como mucho."
msgstr "What was read from NetBox takes %(mb)s MB and the server accepts %(max)s MB at most."

#: agent/client.py:450
#, python-format
msgid "El servidor respondió %(code)s: %(detail)s"
msgstr "The server answered %(code)s: %(detail)s"

#: agent/client.py:454 agent/client.py:460
#, python-format
msgid "No se pudo hablar con el servidor: %(error)s"
msgstr "Couldn't reach the server: %(error)s"

#: agent/client.py:465
msgid "El servidor respondió algo que no es un objeto JSON."
msgstr "The server answered with something that isn't a JSON object."

#: agent/config.py:55
#, python-format
msgid "La dirección del portal es http:// hacia %(host)s: el latido lleva las credenciales de descubrimiento y viajarían en claro. Usa https:// (con CENYA_CA_BUNDLE si el certificado es propio) o, solo para pruebas, CENYA_INSECURE_HTTP=1."
msgstr "The portal address is http:// to %(host)s: the heartbeat carries the discovery credentials and they would travel in the clear. Use https:// (with CENYA_CA_BUNDLE if the certificate is your own) or, for testing only, CENYA_INSECURE_HTTP=1."

#: agent/config.py:130
#, python-format
msgid "El enrolamiento de este agente estaba en una carpeta sin proteger (%(path)s) y no es de fiar: se ha apartado sin usarlo. Enrola el equipo de nuevo: cenya-agent enroll <cadena> --force"
msgstr "This agent's enrolment was in an unprotected folder (%(path)s) and cannot be trusted: it has been set aside unused. Enrol this machine again: cenya-agent enroll <string> --force"

#: agent/config.py:139
msgid "Este agente no está enrolado. En Ajustes → Agentes genera una cadena de conexión y ejecuta: cenya-agent enroll <cadena>"
msgstr "This agent is not enrolled. In Settings → Agents, generate a connection string and run: cenya-agent enroll <string>"

#: agent/connection.py:42
msgid "La cadena de conexión no es válida: debe parecerse a cenya://portal.midominio.com/XXXX-XXXX-XXXX. Cópiala entera de Ajustes → Agentes."
msgstr "The connection string is not valid: it should look like cenya://portal.mycompany.com/XXXX-XXXX-XXXX. Copy it whole from Settings → Agents."

#: agent/control.py:401
#, python-format
msgid "El servidor ha rechazado este agente (%(error)s): no barre ni usa ninguna credencial hasta que lo acepte de nuevo, y le pregunta cada %(minutes)d minutos. Si se revocó, hay que enrolarlo otra vez."
msgstr "The server has rejected this agent (%(error)s): it will not scan or use any credential until the server accepts it again, and it asks every %(minutes)d minutes. If it was revoked, it has to be enrolled again."

#: agent/control.py:407
#, python-format
msgid "La instalación de Cenya está en solo lectura (%(error)s): el agente no empieza ninguna tarea hasta que el servidor vuelva a aceptar resultados."
msgstr "The Cenya installation is read-only (%(error)s): the agent will not start any task until the server accepts results again."

#: agent/control.py:418
msgid "[agente] El servidor vuelve a aceptar a este agente."
msgstr "[agent] The server accepts this agent again."

#: agent/control.py:446
msgid "[agente] El portal guarda otra clave para este agente: no podrá abrir las credenciales selladas. Enrólalo de nuevo (cenya-agent enroll <cadena> --force)."
msgstr "[agent] The portal holds a different key for this agent: it will not be able to open sealed credentials. Enrol it again (cenya-agent enroll <string> --force)."

#: agent/control.py:481
msgid "[agente] Configuración nueva recibida."
msgstr "[agent] New configuration received."

#: agent/control.py:487
#, python-format
msgid "[agente] Hay una versión nueva del agente: %(version)s."
msgstr "[agent] A new version of the agent is available: %(version)s."

#: agent/control.py:516
#, python-format
msgid "[agente] Encargo recibido: %(kind)s."
msgstr "[agent] Order received: %(kind)s."

#: agent/enroll.py:71
msgid "El servidor no devolvió ningún token. ¿Es la dirección de un portal de Cenya?"
msgstr "The server returned no token. Is that the address of a Cenya portal?"

#: agent/enroll.py:87
#, python-format
msgid "%(error)s El código ya se ha usado: genera otra cadena en Ajustes → Agentes."
msgstr "%(error)s The code has already been used: generate another string in Settings → Agents."

#: agent/enroll.py:101
#, python-format
msgid "[agente] Enrolado como «%(name)s» en %(url)s."
msgstr "[agent] Enrolled as «%(name)s» at %(url)s."

#: agent/enroll.py:130
#, python-format
msgid "Este equipo ya está enrolado como «%(name)s» en %(url)s. Para enrolarlo de nuevo, añade --force."
msgstr "This machine is already enrolled as «%(name)s» at %(url)s. To enrol it again, add --force."

#: agent/enroll.py:138
msgid "Cadena de conexión (la de Ajustes → Agentes): "
msgstr "Connection string (the one in Settings → Agents): "

#: agent/enroll.py:141
msgid "Falta la cadena de conexión: cenya-agent enroll cenya://portal.midominio.com/XXXX-XXXX-XXXX"
msgstr "The connection string is missing: cenya-agent enroll cenya://portal.mycompany.com/XXXX-XXXX-XXXX"

#: agent/enroll.py:149 agent/localops.py:929
msgid "El enrolamiento ha fallado."
msgstr "Enrolment failed."

#: agent/enroll.py:151
#, python-format
msgid "Agente «%(name)s» enrolado en %(url)s."
msgstr "Agent «%(name)s» enrolled at %(url)s."

#: agent/enroll.py:152
#, python-format
msgid "El token queda guardado de forma protegida en %(path)s; no hace falta copiarlo."
msgstr "The token is saved in protected form at %(path)s; there is nothing to copy."

#: agent/enroll.py:153
msgid "Para dejarlo funcionando, ejecuta: cenya-agent"
msgstr "To leave it running, run: cenya-agent"

#: agent/goodbye.py:51 agent/localops.py:963
#, python-format
msgid "No se pudo avisar al servidor (%(error)s). El enrolamiento de este equipo se borra igualmente; el agente seguirá apareciendo en Ajustes → Agentes hasta que se borre allí."
msgstr "Could not tell the server (%(error)s). This machine's enrolment is removed anyway; the agent will still appear in Settings → Agents until it is deleted there."

#: agent/goodbye.py:58
#, python-format
msgid "Se ha avisado al servidor (%(url)s): este agente queda dado de baja."
msgstr "The server (%(url)s) has been told: this agent is now removed."

#: agent/goodbye.py:61
#, python-format
msgid "Borrado: %(path)s"
msgstr "Removed: %(path)s"

#: agent/goodbye.py:63
#, python-format
msgid "No había enrolamiento que borrar en %(path)s."
msgstr "There was no enrolment to remove in %(path)s."

#: agent/installer_text.py:35
msgid "Hace falta un PowerShell de administrador: instalar un servicio lo exige Windows."
msgstr "This needs an administrator PowerShell: Windows requires it to install a service."

#: agent/installer_text.py:36
#, python-format
msgid "No se encuentra %(exe)s. ¿Está instalado el agente con el extra [windows] en %(dir)s?"
msgstr "%(exe)s can't be found. Is the agent installed with the [windows] extra in %(dir)s?"

#: agent/installer_text.py:37
msgid "Cadena de conexión (Ajustes → Agentes → Añadir un agente)"
msgstr "Connection string (Settings → Agents → Add an agent)"

#: agent/installer_text.py:38
msgid "Sin enrolar el agente, el servicio no puede arrancar."
msgstr "Without enrolling the agent, the service cannot start."

#: agent/installer_text.py:39
msgid "El enrolamiento ha fallado: el motivo está justo encima."
msgstr "Enrolment failed: the reason is just above."

#: agent/installer_text.py:40
msgid "Con -Token hace falta también -Url."
msgstr "-Token also needs -Url."

#: agent/installer_text.py:41
msgid "Deteniendo el servicio para actualizarlo…"
msgstr "Stopping the service to update it…"

#: agent/installer_text.py:42
#, python-format
msgid "La instalación del servicio falló (código %(code)s)."
msgstr "Installing the service failed (code %(code)s)."

#: agent/installer_text.py:43
msgid "No se pudo configurar el reinicio automático (sc.exe failure)."
msgstr "Automatic restart could not be configured (sc.exe failure)."

#: agent/installer_text.py:44
#, python-format
msgid "No se encuentra %(tray)s: el icono de bandeja no se instala (¿agente anterior a esta versión?)."
msgstr "%(tray)s can't be found: the tray icon is not installed (agent older than this version?)."

#: agent/installer_text.py:45
#, python-format
msgid "El servicio no arrancó. Mira el Visor de eventos: Registros de Windows → Aplicación, origen %(source)s."
msgstr "The service didn't start. Check Event Viewer: Windows Logs → Application, source %(source)s."

#: agent/installer_text.py:46
msgid "Servicio «Cenya Agent» instalado y en marcha."
msgstr "“Cenya Agent” service installed and running."

#: agent/installer_text.py:47
#, python-format
msgid "Sus mensajes van al Visor de eventos (Aplicación, origen %(source)s)."
msgstr "Its messages go to Event Viewer (Application, source %(source)s)."

#: agent/installer_text.py:48
#, python-format
msgid "Se gestiona desde services.msc, o con: %(exe)s stop | start | remove"
msgstr "Manage it from services.msc, or with: %(exe)s stop | start | remove"

#: agent/installer_text.py:49
#, python-format
msgid "El icono de bandeja aparecerá al iniciar sesión. Para verlo ya: %(tray)s"
msgstr "The tray icon will appear at sign-in. To see it now: %(tray)s"

#: agent/installer_text.py:51
msgid "Windows lo guarda al principio en el desplegable ^ de la barra de tareas: arrástralo fuera para tenerlo siempre a la vista."
msgstr "Windows first keeps it in the ^ overflow on the taskbar: drag it out to keep it always in view."

#: agent/localapi.py:158
msgid "La respuesta es demasiado grande para el canal local."
msgstr "The answer is too large for the local channel."

#: agent/localapi.py:178
msgid "La petición no es JSON válido."
msgstr "The request is not valid JSON."

#: agent/localapi.py:180
msgid "La petición tiene que ser un objeto JSON."
msgstr "The request must be a JSON object."

#: agent/localapi.py:183
msgid "El campo «id» tiene que ser un número o un texto."
msgstr "The “id” field must be a number or a string."

#: agent/localapi.py:186
msgid "Falta el campo «op»."
msgstr "The “op” field is missing."

#: agent/localapi.py:191
msgid "El campo «args» tiene que ser un objeto."
msgstr "The “args” field must be an object."

#: agent/localapi.py:217
#, python-format
msgid "Operación desconocida: %(op)s"
msgstr "Unknown operation: %(op)s"

#: agent/localapi.py:219
msgid "Esta operación solo la puede hacer un administrador."
msgstr "Only an administrator can do this operation."

#: agent/localapi.py:222
msgid "Este agente no sabe hacer todavía esa operación."
msgstr "This agent cannot do that operation yet."

#: agent/localapi.py:230
#, python-format
msgid "[canal local] Fallo inesperado en %(op)s: %(type)s"
msgstr "[local channel] Unexpected failure in %(op)s: %(type)s"

#: agent/localapi.py:231
#, python-format
msgid "Error inesperado en el agente (%(type)s)."
msgstr "Unexpected error in the agent (%(type)s)."

#: agent/localapi.py:377 agent/localpipe.py:407 agent/localpipe.py:619
msgid "Hay demasiadas conexiones abiertas con el agente."
msgstr "Too many connections are open to the agent."

#: agent/localapi.py:382
msgid "La petición es demasiado grande."
msgstr "The request is too large."

#: agent/localclient.py:392
msgid "Esta instalación no puede hablar con el servicio: falta pywin32."
msgstr "This installation cannot talk to the service: pywin32 is missing."

#: agent/localclient.py:395
msgid "El canal del agente lo ha abierto otro programa, no el servicio de Cenya: no se le envía nada. Reinicia el servicio y avisa a quien administre este equipo."
msgstr "The agent's channel was opened by another program, not the Cenya service: nothing is sent to it. Restart the service and tell whoever administers this computer."

#: agent/localclient.py:399
msgid "Esta cuenta no tiene permiso para hablar con el servicio del agente."
msgstr "This account is not allowed to talk to the agent service."

#: agent/localclient.py:400
msgid "El servicio del agente no está en marcha en este equipo."
msgstr "The agent service is not running on this computer."

#: agent/localclient.py:405
msgid "Esto solo lo puede hacer un administrador: abre la consola con «Ejecutar como administrador»."
msgstr "Only an administrator can do this: open the console with “Run as administrator”."

#: agent/localclient.py:406
msgid "Esto solo lo puede hacer root o la cuenta con la que corre el agente."
msgstr "Only root or the account the agent runs as can do this."

#: agent/localclient.py:411
#, python-format
msgid "Cenya Agent %(version)s"
msgstr "Cenya Agent %(version)s"

#: agent/localclient.py:416
msgid "No está conectado a ningún portal: cenya-agent connect <cadena>"
msgstr "Not connected to any portal: cenya-agent connect <string>"

#: agent/localclient.py:420
#, python-format
msgid "Conectado como «%(name)s» a %(portal)s (protocolo %(protocol)s)."
msgstr "Connected as “%(name)s” to %(portal)s (protocol %(protocol)s)."

#: agent/localclient.py:426
#, python-format
msgid "Conexión: correcta (último contacto a las %(clock)s)."
msgstr "Connection: working (last contact at %(clock)s)."

#: agent/localclient.py:428
#, python-format
msgid "Conexión: falla (%(error)s)."
msgstr "Connection: failing (%(error)s)."

#: agent/localclient.py:430
msgid "Conexión: el servidor ha rechazado a este agente; hay que conectarlo de nuevo."
msgstr "Connection: the server has rejected this agent; it must be connected again."

#: agent/localclient.py:432
msgid "Conexión: la instalación de Cenya está en solo lectura."
msgstr "Connection: the Cenya installation is read-only."

#: agent/localclient.py:434
msgid "Conexión: todavía sin noticias del servidor."
msgstr "Connection: no word from the server yet."

#: agent/localclient.py:443
#, python-format
msgid "Ahora: trabajando en %(task)s%(progress)s."
msgstr "Now: working on %(task)s%(progress)s."

#: agent/localclient.py:445
msgid "Ahora: en pausa hasta que se reanude (cenya-agent resume)."
msgstr "Now: paused until resumed (cenya-agent resume)."

#: agent/localclient.py:447
#, python-format
msgid "Ahora: en pausa hasta las %(clock)s."
msgstr "Now: paused until %(clock)s."

#: agent/localclient.py:449
msgid "Ahora: esperando a la siguiente tarea."
msgstr "Now: waiting for the next task."

#: agent/localclient.py:452
msgid "Tareas:"
msgstr "Tasks:"

#: agent/localclient.py:456
#, python-format
msgid "%(task)s: cada %(every)s, última %(last)s (%(status)s), próxima %(next)s"
msgstr "%(task)s: every %(every)s, last %(last)s (%(status)s), next %(next)s"

#: agent/localclient.py:467
#, python-format
msgid "%(n)d envío pendiente en la cola local."
msgid_plural "%(n)d envíos pendientes en la cola local."
msgstr[0] "%(n)d upload pending in the local queue."
msgstr[1] "%(n)d uploads pending in the local queue."

#: agent/localclient.py:470
#, python-format
msgid "Hay una versión nueva del agente: %(version)s."
msgstr "A new version of the agent is available: %(version)s."

#: agent/localclient.py:474
#, python-format
msgid "Exportando NetBox: %(step)s (%(done)s de %(total)s)."
msgstr "Exporting NetBox: %(step)s (%(done)s of %(total)s)."

#: agent/localclient.py:483
#, python-format
msgid "%(n)d hora"
msgid_plural "%(n)d horas"
msgstr[0] "%(n)d hour"
msgstr[1] "%(n)d hours"

#: agent/localclient.py:486
#, python-format
msgid "%(n)d minuto"
msgid_plural "%(n)d minutos"
msgstr[0] "%(n)d minute"
msgstr[1] "%(n)d minutes"

#: agent/localclient.py:487
#, python-format
msgid "%(n)d segundo"
msgid_plural "%(n)d segundos"
msgstr[0] "%(n)d second"
msgstr[1] "%(n)d seconds"

