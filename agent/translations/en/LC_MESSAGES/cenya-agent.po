msgstr "Enrolling from this console; start the service afterwards."

#: agent/localclient.py:763
#, python-format
msgid "Conectado como «%(name)s» a %(portal)s. El agente se reinicia con la conexión nueva."
msgstr "Connected as “%(name)s” to %(portal)s. The agent restarts with the new connection."

#: agent/localclient.py:777
msgid "Para borrar el enrolamiento sin el servicio: cenya-agent goodbye"
msgstr "To remove the enrolment without the service: cenya-agent goodbye"

#: agent/localops.py:184
msgid "No existe ese fichero."
msgstr "That file does not exist."

#: agent/localops.py:188
msgid "No es un fichero de certificados que se pueda leer (PEM)."
msgstr "It is not a readable certificate file (PEM)."

#: agent/localops.py:198
msgid "Ajuste desconocido."
msgstr "Unknown setting."

#: agent/localops.py:202
msgid "Idioma no disponible: es, en, de, fr, pt_BR o vacío."
msgstr "Language not available: es, en, de, fr, pt_BR or empty."

#: agent/localops.py:207
msgid "Tiene que ser una ruta."
msgstr "It must be a path."

#: agent/localops.py:214
msgid "Tiene que ser un objeto con «mode» y «url»."
msgstr "It must be an object with “mode” and “url”."

#: agent/localops.py:219
msgid "Modo de proxy no válido: system, manual o none."
msgstr "Invalid proxy mode: system, manual or none."

#: agent/localops.py:228 agent/localops.py:439
