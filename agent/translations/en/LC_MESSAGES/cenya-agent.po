msgstr "Usage: cenya-agent status | run <task> | pause [--hours N] | resume | logs [-n N] [-f] | doctor | connect <string> | disconnect"

#: agent/localclient.py:562 agent/app/view.py:133
msgid "El servicio no ha contestado a tiempo."
msgstr "The service did not answer in time."

#: agent/localclient.py:565
msgid "Se ha perdido la conexión con el servicio."
msgstr "The connection to the service was lost."

#: agent/localclient.py:592
#, python-format
