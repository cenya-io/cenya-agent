msgstr "Task %(task)s queued: it starts as soon as the one in progress finishes."

#: agent/localclient.py:594
msgid "Antes tiene que llegar la configuración del servidor."
msgstr "The server's configuration has to arrive first."

#: agent/localclient.py:596
msgid "La instalación de Cenya está en solo lectura: la tarea espera a que vuelva a aceptar resultados."
msgstr "The Cenya installation is read-only: the task waits until results are accepted again."

#: agent/localclient.py:615
#, python-format
msgid "Agente en pausa hasta las %(clock)s. La tarea en curso, si hay una, termina."
msgstr "Agent paused until %(clock)s. The task in progress, if any, will finish."

#: agent/localclient.py:624
msgid "Pausa local levantada."
msgstr "Local pause lifted."

#: agent/localclient.py:627
#, python-format
msgid "Sigue en pausa hasta las %(clock)s: esa pausa se puso desde la web y se quita allí."
msgstr "Still paused until %(clock)s: that pause was set from the web and is lifted there."

#: agent/localclient.py:681
#, python-format
msgid "Tampoco se puede leer el registro (%(path)s) desde esta cuenta."
msgstr "The log (%(path)s) cannot be read from this account either."

#: agent/localclient.py:683
#, python-format
msgid "Registro leído directamente de %(path)s:"
msgstr "Log read directly from %(path)s:"

#: agent/localclient.py:703
msgid "Se prueba la conexión desde esta consola, sin el servicio."
msgstr "Testing the connection from this console, without the service."

#: agent/localclient.py:705
msgid "Conexión con el portal:"
msgstr "Connection to the portal:"

#: agent/localclient.py:710
msgid "Esta instalación:"
msgstr "This installation:"

#: agent/localclient.py:712
msgid "completa (colectores, librerías y traducciones)."
msgstr "complete (collectors, libraries and translations)."

#: agent/localclient.py:712
msgid "incompleta: detalle con cenya-agent selftest."
msgstr "incomplete: details with cenya-agent selftest."

#: agent/localclient.py:749
msgid "Falta la cadena de conexión: cenya-agent connect cenya://portal.midominio.com/XXXX-XXXX-XXXX"
msgstr "The connection string is missing: cenya-agent connect cenya://portal.mydomain.com/XXXX-XXXX-XXXX"

#: agent/localclient.py:759
