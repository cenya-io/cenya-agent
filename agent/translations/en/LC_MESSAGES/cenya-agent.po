#: agent/__main__.py:40 agent/runtime.py:88 agent/status.py:424
#, python-format
msgid "%(n)d hallazgo nuevo"
msgid_plural "%(n)d hallazgos nuevos"
msgstr[0] "%(n)d new finding"
msgstr[1] "%(n)d new findings"

#: agent/__main__.py:41 agent/runtime.py:89 agent/status.py:426
#, python-format
msgid "%(n)d ya conocido."
msgid_plural "%(n)d ya conocidos."
msgstr[0] "%(n)d already known."
msgstr[1] "%(n)d already known."

#: agent/__main__.py:44
#, python-format
msgid "%(n)d envío"
msgid_plural "%(n)d envíos"
msgstr[0] "%(n)d batch"
msgstr[1] "%(n)d batches"

#: agent/__main__.py:45
#, python-format
msgid "[agente] Barrido enviado en %(batches)s: %(created)s, %(refreshed)s"
msgstr "[agent] Sweep sent in %(batches)s: %(created)s, %(refreshed)s"

#: agent/__main__.py:46
#, python-format
msgid "[agente] Barrido enviado: %(created)s, %(refreshed)s"
msgstr "[agent] Sweep sent: %(created)s, %(refreshed)s"

#: agent/__main__.py:61 agent/control.py:435 agent/runtime.py:440
#, python-format
msgid "Error inesperado: %(error)s"
msgstr "Unexpected error: %(error)s"

#: agent/__main__.py:228 agent/__main__.py:272 agent/__main__.py:279
#: agent/control.py:423 agent/runtime.py:242
#, python-format
msgid "[agente] %(error)s"
msgstr "[agent] %(error)s"

#: agent/__main__.py:242
#, python-format
msgid "[agente] Conectado a %(url)s con el protocolo 2."
msgstr "[agent] Connected to %(url)s using protocol 2."

#: agent/__main__.py:246
msgid "[agente] El servidor solo habla el protocolo 1: se sigue con el bucle de siempre."
msgstr "[agent] The server only speaks protocol 1: carrying on with the usual loop."

#: agent/__main__.py:248
msgid "[agente] Detenido."
msgstr "[agent] Stopped."

#: agent/__main__.py:263
#, python-format
msgid "[agente] Empujando a %(url)s cada ~%(seconds)d s."
msgstr "[agent] Pushing to %(url)s every ~%(seconds)d s."

#: agent/client.py:360
#, python-format
msgid "El servidor respondió %(code)s: %(detail)s"
msgstr "The server answered %(code)s: %(detail)s"

#: agent/client.py:364
#, python-format
msgid "No se pudo hablar con el servidor: %(error)s"
msgstr "Couldn't reach the server: %(error)s"

#: agent/client.py:369
msgid "El servidor respondió algo que no es un objeto JSON."
msgstr "The server answered with something that isn't a JSON object."

#: agent/config.py:55
#, python-format
msgid "La dirección del portal es http:// hacia %(host)s: el latido lleva las credenciales de descubrimiento y viajarían en claro. Usa https:// (con CENYA_CA_BUNDLE si el certificado es propio) o, solo para pruebas, CENYA_INSECURE_HTTP=1."
msgstr "The portal address is http:// to %(host)s: the heartbeat carries the discovery credentials and they would travel in the clear. Use https:// (with CENYA_CA_BUNDLE if the certificate is your own) or, for testing only, CENYA_INSECURE_HTTP=1."

#: agent/config.py:130
#, python-format
msgid "El enrolamiento de este agente estaba en una carpeta sin proteger (%(path)s) y no es de fiar: se ha apartado sin usarlo. Enrola el equipo de nuevo: cenya-agent enroll <cadena> --force"
msgstr "This agent's enrolment was in an unprotected folder (%(path)s) and cannot be trusted: it has been set aside unused. Enrol this machine again: cenya-agent enroll <string> --force"

#: agent/config.py:139
msgid "Este agente no está enrolado. En Ajustes → Agentes genera una cadena de conexión y ejecuta: cenya-agent enroll <cadena>"
msgstr "This agent is not enrolled. In Settings → Agents, generate a connection string and run: cenya-agent enroll <string>"

#: agent/connection.py:42
msgid "La cadena de conexión no es válida: debe parecerse a cenya://portal.midominio.com/XXXX-XXXX-XXXX. Cópiala entera de Ajustes → Agentes."
msgstr "The connection string is not valid: it should look like cenya://portal.mycompany.com/XXXX-XXXX-XXXX. Copy it whole from Settings → Agents."

#: agent/control.py:279
msgid "[agente] Configuración nueva recibida."
msgstr "[agent] New configuration received."

#: agent/control.py:285
#, python-format
msgid "[agente] Hay una versión nueva del agente: %(version)s."
msgstr "[agent] A new version of the agent is available: %(version)s."

#: agent/control.py:313
#, python-format
msgid "[agente] Encargo recibido: %(kind)s."
msgstr "[agent] Order received: %(kind)s."

#: agent/enroll.py:66
msgid "El servidor no devolvió ningún token. ¿Es la dirección de un portal de Cenya?"
msgstr "The server returned no token. Is that the address of a Cenya portal?"

#: agent/enroll.py:74
#, python-format
msgid "%(error)s El código ya se ha usado: genera otra cadena en Ajustes → Agentes."
msgstr "%(error)s The code has already been used: generate another string in Settings → Agents."

#: agent/enroll.py:88
#, python-format
msgid "[agente] Enrolado como «%(name)s» en %(url)s."
msgstr "[agent] Enrolled as «%(name)s» at %(url)s."

#: agent/enroll.py:117
#, python-format
msgid "Este equipo ya está enrolado como «%(name)s» en %(url)s. Para enrolarlo de nuevo, añade --force."
msgstr "This machine is already enrolled as «%(name)s» at %(url)s. To enrol it again, add --force."

#: agent/enroll.py:125
msgid "Cadena de conexión (la de Ajustes → Agentes): "
msgstr "Connection string (the one in Settings → Agents): "

#: agent/enroll.py:128
msgid "Falta la cadena de conexión: cenya-agent enroll cenya://portal.midominio.com/XXXX-XXXX-XXXX"
msgstr "The connection string is missing: cenya-agent enroll cenya://portal.mycompany.com/XXXX-XXXX-XXXX"

#: agent/enroll.py:136
msgid "El enrolamiento ha fallado."
msgstr "Enrolment failed."

#: agent/enroll.py:138
#, python-format
msgid "Agente «%(name)s» enrolado en %(url)s."
msgstr "Agent «%(name)s» enrolled at %(url)s."

#: agent/enroll.py:139
#, python-format
msgid "El token queda guardado de forma protegida en %(path)s; no hace falta copiarlo."
msgstr "The token is saved in protected form at %(path)s; there is nothing to copy."

#: agent/enroll.py:140
msgid "Para dejarlo funcionando, ejecuta: cenya-agent"
msgstr "To leave it running, run: cenya-agent"

#: agent/installer_text.py:35
msgid "Hace falta un PowerShell de administrador: instalar un servicio lo exige Windows."
msgstr "This needs an administrator PowerShell: Windows requires it to install a service."

#: agent/installer_text.py:36
#, python-format
msgid "No se encuentra %(exe)s. ¿Está instalado el agente con el extra [windows] en %(dir)s?"
msgstr "%(exe)s can't be found. Is the agent installed with the [windows] extra in %(dir)s?"

#: agent/installer_text.py:37
msgid "Cadena de conexión (Ajustes → Agentes → Añadir un agente)"
msgstr "Connection string (Settings → Agents → Add an agent)"

#: agent/installer_text.py:38
msgid "Sin enrolar el agente, el servicio no puede arrancar."
msgstr "Without enrolling the agent, the service cannot start."

#: agent/installer_text.py:39
msgid "El enrolamiento ha fallado: el motivo está justo encima."
msgstr "Enrolment failed: the reason is just above."

#: agent/installer_text.py:40
msgid "Con -Token hace falta también -Url."
msgstr "-Token also needs -Url."

#: agent/installer_text.py:41
msgid "Deteniendo el servicio para actualizarlo…"
msgstr "Stopping the service to update it…"

#: agent/installer_text.py:42
#, python-format
msgid "La instalación del servicio falló (código %(code)s)."
msgstr "Installing the service failed (code %(code)s)."

#: agent/installer_text.py:43
msgid "No se pudo configurar el reinicio automático (sc.exe failure)."
msgstr "Automatic restart could not be configured (sc.exe failure)."

#: agent/installer_text.py:44
#, python-format
msgid "No se encuentra %(tray)s: el icono de bandeja no se instala (¿agente anterior a esta versión?)."
msgstr "%(tray)s can't be found: the tray icon is not installed (agent older than this version?)."

#: agent/installer_text.py:45
#, python-format
msgid "El servicio no arrancó. Mira el Visor de eventos: Registros de Windows → Aplicación, origen %(source)s."
msgstr "The service didn't start. Check Event Viewer: Windows Logs → Application, source %(source)s."

#: agent/installer_text.py:46
msgid "Servicio «Cenya Agent» instalado y en marcha."
msgstr "“Cenya Agent” service installed and running."

#: agent/installer_text.py:47
#, python-format
msgid "Sus mensajes van al Visor de eventos (Aplicación, origen %(source)s)."
msgstr "Its messages go to Event Viewer (Application, source %(source)s)."

#: agent/installer_text.py:48
#, python-format
msgid "Se gestiona desde services.msc, o con: %(exe)s stop | start | remove"
msgstr "Manage it from services.msc, or with: %(exe)s stop | start | remove"

#: agent/installer_text.py:49
#, python-format
msgid "El icono de bandeja aparecerá al iniciar sesión. Para verlo ya: %(tray)s"
msgstr "The tray icon will appear at sign-in. To see it now: %(tray)s"

#: agent/installer_text.py:51
msgid "Windows lo guarda al principio en el desplegable ^ de la barra de tareas: arrástralo fuera para tenerlo siempre a la vista."
msgstr "Windows first keeps it in the ^ overflow on the taskbar: drag it out to keep it always in view."

#: agent/netbox_export.py:124
#, python-format
msgid "NetBox no respondió en %(seconds)s segundos. ¿Es esa la URL y llega la red hasta allí?"
msgstr "NetBox didn't respond within %(seconds)s seconds. Is that the right URL, and does the network reach it?"

#: agent/netbox_export.py:137
msgid "NetBox rechazó el token. Crea uno de solo lectura en tu NetBox (Admin → API tokens) y prueba de nuevo."
msgstr "NetBox rejected the token. Create a read-only one in your NetBox (Admin → API tokens) and try again."

#: agent/netbox_export.py:142
msgid "NetBox respondió con una redirección (¿falta o sobra «https» o una barra al final de la URL?). No se siguen redirecciones con un token."
msgstr "NetBox answered with a redirect (is «https» or a trailing slash missing from, or extra in, the URL?). Redirects are not followed with a token."

#: agent/netbox_export.py:146
#, python-format
msgid "NetBox respondió %(code)s."
msgstr "NetBox answered %(code)s."

#: agent/netbox_export.py:151
#, python-format
msgid "El certificado de ese NetBox no es válido (%(reason)s). Si es un NetBox de tu red con certificado autofirmado o caducado, añade --insecure y vuelve a intentarlo."
msgstr "That NetBox's certificate isn't valid (%(reason)s). If it's a NetBox on your network with a self-signed or expired certificate, add --insecure and try again."

#: agent/netbox_export.py:158
#, python-format
msgid "No se pudo hablar con NetBox: %(reason)s"
msgstr "Couldn't talk to NetBox: %(reason)s"

#: agent/netbox_export.py:162
msgid "La respuesta de NetBox no es JSON. ¿Es esa la URL de NetBox?"
msgstr "NetBox's response isn't JSON. Is that the NetBox URL?"

#: agent/netbox_export.py:181
#, python-format
msgid "La respuesta de %(path)s no tiene la forma esperada."
msgstr "The response from %(path)s doesn't have the expected shape."

#: agent/netbox_export.py:186
#, python-format
msgid "%(path)s tiene más de %(max)s objetos. Esta importación está pensada para inventarios de pyme; hablemos antes de traer eso."
msgstr "%(path)s has more than %(max)s objects. This import is meant for small-business inventories; let's talk before bringing that in."

#: agent/netbox_export.py:227
msgid "La URL tiene que empezar por http:// o https://."
msgstr "The URL must start with http:// or https://."

#: agent/netbox_export.py:229
msgid "La URL no dice a qué servidor conectarse."
msgstr "The URL doesn't say which server to connect to."

#: agent/netbox_export.py:244
#, python-format
msgid "Uso: %(prog)s URL [--output FICHERO] [--insecure]"
msgstr "Usage: %(prog)s URL [--output FILE] [--insecure]"

#: agent/netbox_export.py:278
#, python-format
msgid "Falta el token de NetBox: pásalo en la variable %(var)s."
msgstr "The NetBox token is missing: pass it in the %(var)s variable."

#: agent/netbox_export.py:282
msgid "Token de solo lectura de NetBox (no se muestra al escribirlo): "
msgstr "NetBox read-only token (not shown as you type): "

#: agent/netbox_export.py:284
msgid "Sin token no se puede leer NetBox."
msgstr "Without a token NetBox can't be read."

#: agent/netbox_export.py:288
#, python-format
msgid "Leyendo %(path)s…"
msgstr "Reading %(path)s…"

#: agent/netbox_export.py:299
#, python-format
msgid "No se pudo escribir %(path)s: %(error)s"
msgstr "Couldn't write %(path)s: %(error)s"

#: agent/netbox_export.py:306
#, python-format
msgid "Exportado %(n)d objeto a %(path)s."
msgid_plural "Exportados %(n)d objetos a %(path)s."
msgstr[0] "Exported %(n)d object to %(path)s."
msgstr[1] "Exported %(n)d objects to %(path)s."

#: agent/netbox_export.py:312
msgid "Súbelo en Cenya: Ajustes → Importar → «NetBox, desde un fichero»."
msgstr "Upload it in Cenya: Settings → Import → «NetBox, from a file»."

#: agent/runtime.py:86
#, python-format
msgid "[agente] Tarea %(task)s enviada: %(created)s, %(refreshed)s"
msgstr "[agent] Task %(task)s sent: %(created)s, %(refreshed)s"

#: agent/runtime.py:428
#, python-format
msgid "[agente] Tarea %(task)s guardada en la cola local: se enviará cuando el servidor conteste."
msgstr "[agent] Task %(task)s saved in the local queue: it will be sent when the server answers."

#: agent/status.py:302
msgid "hace menos de un minuto"
msgstr "less than a minute ago"

#: agent/status.py:305
#, python-format
msgid "hace %(n)d minuto"
msgid_plural "hace %(n)d minutos"
msgstr[0] "%(n)d minute ago"
msgstr[1] "%(n)d minutes ago"

#: agent/status.py:308
#, python-format
msgid "hace %(n)d hora"
msgid_plural "hace %(n)d horas"
msgstr[0] "%(n)d hour ago"
msgstr[1] "%(n)d hours ago"

#: agent/status.py:310
#, python-format
msgid "hace %(n)d día"
msgid_plural "hace %(n)d días"
msgstr[0] "%(n)d day ago"
msgstr[1] "%(n)d days ago"

#: agent/status.py:326 agent/status.py:341
msgid "Agente detenido"
msgstr "Agent stopped"

#: agent/status.py:326
msgid "El servicio está detenido y no hay datos de su última ejecución."
msgstr "The service is stopped and there is no data from its last run."

#: agent/status.py:328
msgid "Servicio no instalado"
msgstr "Service not installed"

#: agent/status.py:328
msgid "El servicio del agente no está instalado en este equipo."
msgstr "The agent service is not installed on this computer."

#: agent/status.py:329
msgid "Sin datos del agente"
msgstr "No data from the agent"

#: agent/status.py:329
msgid "No se encuentra el fichero de estado: el agente no ha arrancado nunca aquí, o no se puede leer."
msgstr "The status file can't be found: the agent has never started here, or the file can't be read."

#: agent/status.py:340
msgid "Agente detenido por un error"
msgstr "Agent stopped by an error"

#: agent/status.py:345
msgid "hace un tiempo desconocido"
msgstr "an unknown time ago"

#: agent/status.py:348
msgid "Sin noticias del agente"
msgstr "No news from the agent"

#: agent/status.py:350
#, python-format
msgid "La última noticia del agente es de %(ago)s: puede haberse detenido, o el fichero de estado ya no se actualiza."
msgstr "Last heard from the agent %(ago)s: it may have stopped, or the status file is no longer updated."

#: agent/status.py:360
msgid "No puede hablar con el servidor"
msgstr "Can't reach the server"

#: agent/status.py:366
msgid "Barriendo la red"
msgstr "Sweeping the network"

#: agent/status.py:367
#, python-format
msgid "Paso actual: %(step)s"
msgstr "Current step: %(step)s"

#: agent/status.py:370
msgid "Arrancando"
msgstr "Starting"

#: agent/status.py:371
msgid "En marcha"
msgstr "Running"

#: agent/status.py:379
#, python-format
msgid "Cenya Agent: %(headline)s"
msgstr "Cenya Agent: %(headline)s"

#: agent/status.py:421
#, python-format
msgid "Último barrido: %(clock)s (%(ago)s)."
msgstr "Last sweep: %(clock)s (%(ago)s)."

#: agent/status.py:434
#, python-format
msgid "Salió parcial, con %(n)d aviso (detalle en Ajustes → Agentes)."
msgid_plural "Salió parcial, con %(n)d avisos (detalle en Ajustes → Agentes)."
msgstr[0] "Came back partial, with %(n)d warning (details in Settings → Agents)."
msgstr[1] "Came back partial, with %(n)d warnings (details in Settings → Agents)."

#: agent/status.py:441
msgid "Todavía no ha terminado ningún barrido."
msgstr "No sweep has finished yet."

#: agent/status.py:444
#, python-format
msgid "Próximo barrido hacia las %(clock)s."
msgstr "Next sweep around %(clock)s."

#: agent/store.py:572
#, python-format
msgid "No se pudo guardar el enrolamiento de forma segura en %(path)s: %(error)s"
msgstr "The enrolment could not be saved securely at %(path)s: %(error)s"

#: agent/store.py:600
#, python-format
msgid "[agente] La carpeta %(path)s no estaba protegida: se ha apartado sin usarlo lo que otro usuario pudo dejar en ella (%(names)s), y ya queda protegida."
msgstr "[agent] The folder %(path)s was not protected: what another user could have left in it has been set aside unused (%(names)s), and it is now protected."

#: agent/store.py:629
#, python-format
msgid "No se pudo apartar %(path)s, que no es de fiar: %(error)s"
msgstr "Could not set aside %(path)s, which cannot be trusted: %(error)s"

#: agent/store.py:654
#, python-format
msgid "La carpeta %(path)s no está protegida y no se puede proteger (%(error)s): el agente no lee ni guarda en ella su token ni sus credenciales. Ejecútalo como administrador o como servicio."
msgstr "The folder %(path)s is not protected and cannot be protected (%(error)s): the agent will not read or keep its token or credentials there. Run it as an administrator or as a service."

#: agent/tray.py:175
#, python-format
msgid "Versión del agente: %(version)s"
msgstr "Agent version: %(version)s"

#: agent/tray.py:178
#, python-format
msgid "Servidor: %(url)s"
msgstr "Server: %(url)s"

#: agent/tray.py:192
msgid "Ver estado"
msgstr "View status"

#: agent/tray.py:195
msgid "Abrir Ajustes → Agentes"
msgstr "Open Settings → Agents"

#: agent/tray.py:199
msgid "Cerrar este icono"
msgstr "Close this icon"

#: agent/tray.py:272
#, python-format
msgid ""
"El icono de Cenya Agent no ha podido arrancar:\n"
"%(error)s"
msgstr ""
"The Cenya Agent icon could not start:\n"
"%(error)s"

#: agent/winservice.py:161
msgid "El bucle del agente terminó sin que nadie lo parara."
msgstr "The agent loop ended without anyone stopping it."

#: agent/winservice.py:170
#, python-format
msgid "Cenya Agent se ha detenido: %(reason)s"
msgstr "Cenya Agent has stopped: %(reason)s"

#: agent/winservice.py:211
#, python-format
msgid "No se encuentra %(dll)s: la Python con la que se creó este entorno ya no está donde estaba. Vuelve a crear el entorno virtual."
msgstr "%(dll)s can't be found: the Python this environment was created with is no longer where it was. Create the virtual environment again."

#: agent/winservice.py:224
#, python-format
msgid "No se puede reemplazar %(file)s: detén el servicio antes de actualizarlo (%(command)s stop)."
msgstr "%(file)s can't be replaced: stop the service before updating it (%(command)s stop)."

#: agent/winservice.py:312
msgid "Este equipo no está enrolado y en esta consola no hay ningún token: el servicio no podría arrancar. Ejecuta antes cenya-agent enroll <cadena> y vuelve a instalar."
msgstr "This machine is not enrolled and there is no token in this console: the service could not start. Run cenya-agent enroll <string> first and install again."

#: agent/winservice.py:318
#, python-format
msgid "Variables guardadas en el servicio: %(names)s"
msgstr "Variables stored in the service: %(names)s"

#: agent/winservice.py:320
msgid "Sin variables CENYA_* en esta consola: se dejan las que ya tuviera el servicio."
msgstr "No CENYA_* variables in this console: the ones the service already had are kept."

#: agent/winservice.py:322
msgid "La clave del servicio queda legible solo por SYSTEM y Administradores."
msgstr "The service's registry key is now readable only by SYSTEM and Administrators."

#: agent/winservice.py:327
#, python-format
msgid "Estado del agente en %(path)s (lo escribe el servicio; lo lee el icono de bandeja)."
msgstr "Agent status in %(path)s (written by the service, read by the tray icon)."
