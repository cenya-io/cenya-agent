#: agent/__main__.py:41 agent/runtime.py:90 agent/status.py:437
#, python-format
msgid "%(n)d hallazgo nuevo"
msgid_plural "%(n)d hallazgos nuevos"
msgstr[0] "%(n)d neuer Fund"
msgstr[1] "%(n)d neue Funde"

#: agent/__main__.py:42 agent/runtime.py:91 agent/status.py:439
#, python-format
msgid "%(n)d ya conocido."
msgid_plural "%(n)d ya conocidos."
msgstr[0] "%(n)d bereits bekannt."
msgstr[1] "%(n)d bereits bekannt."

#: agent/__main__.py:45
#, python-format
msgid "%(n)d envío"
msgid_plural "%(n)d envíos"
msgstr[0] "%(n)d Teil"
msgstr[1] "%(n)d Teilen"

#: agent/__main__.py:46
#, python-format
msgid "[agente] Barrido enviado en %(batches)s: %(created)s, %(refreshed)s"
msgstr "[Agent] Scan gesendet in %(batches)s: %(created)s, %(refreshed)s"

#: agent/__main__.py:47
#, python-format
msgid "[agente] Barrido enviado: %(created)s, %(refreshed)s"
msgstr "[Agent] Scan gesendet: %(created)s, %(refreshed)s"

#: agent/__main__.py:68 agent/control.py:687 agent/runtime.py:657
#, python-format
msgid "Error inesperado: %(error)s"
msgstr "Unerwarteter Fehler: %(error)s"

#: agent/__main__.py:285 agent/__main__.py:383 agent/__main__.py:390
#: agent/control.py:663 agent/runtime.py:448
#, python-format
msgid "[agente] %(error)s"
msgstr "[Agent] %(error)s"

#: agent/__main__.py:323
msgid "[agente] Detenido."
msgstr "[Agent] Angehalten."

#: agent/__main__.py:355
#, python-format
msgid "[agente] Conectado a %(url)s con el protocolo 2."
msgstr "[Agent] Mit %(url)s über Protokoll 2 verbunden."

#: agent/__main__.py:359
msgid "[agente] El servidor solo habla el protocolo 1: se sigue con el bucle de siempre."
msgstr "[Agent] Der Server spricht nur Protokoll 1: Es geht mit der gewohnten Schleife weiter."

#: agent/__main__.py:374
#, python-format
msgid "[agente] Empujando a %(url)s cada ~%(seconds)d s."
msgstr "[Agent] Sendet an %(url)s alle ~%(seconds)d s."

#: agent/client.py:167
msgid "La dirección del proxy no es válida: revisa el ajuste «proxy» (settings.json o CENYA_PROXY). No se muestra aquí porque puede llevar una contraseña."
msgstr "Die Proxy-Adresse ist ungültig: Prüfen Sie die Einstellung „proxy“ (settings.json oder CENYA_PROXY). Sie wird hier nicht angezeigt, weil sie ein Passwort enthalten kann."

#: agent/client.py:404
#, python-format
msgid "Lo leído de NetBox ocupa %(mb)s MB y el servidor admite %(max)s MB como mucho."
msgstr "Die aus NetBox gelesenen Daten belegen %(mb)s MB, der Server nimmt höchstens %(max)s MB an."

#: agent/client.py:450
#, python-format
msgid "El servidor respondió %(code)s: %(detail)s"
msgstr "Der Server antwortete %(code)s: %(detail)s"

#: agent/client.py:454 agent/client.py:460
#, python-format
msgid "No se pudo hablar con el servidor: %(error)s"
msgstr "Keine Verbindung zum Server: %(error)s"

#: agent/client.py:465
msgid "El servidor respondió algo que no es un objeto JSON."
msgstr "Die Antwort des Servers ist kein JSON-Objekt."

#: agent/config.py:55
#, python-format
msgid "La dirección del portal es http:// hacia %(host)s: el latido lleva las credenciales de descubrimiento y viajarían en claro. Usa https:// (con CENYA_CA_BUNDLE si el certificado es propio) o, solo para pruebas, CENYA_INSECURE_HTTP=1."
msgstr "Die Portaladresse ist http:// zu %(host)s: Der Heartbeat enthält die Anmeldedaten für die Erkennung, die unverschlüsselt übertragen würden. https:// verwenden (mit CENYA_CA_BUNDLE bei eigenem Zertifikat) oder, nur zum Testen, CENYA_INSECURE_HTTP=1."

#: agent/config.py:130
#, python-format
msgid "El enrolamiento de este agente estaba en una carpeta sin proteger (%(path)s) y no es de fiar: se ha apartado sin usarlo. Enrola el equipo de nuevo: cenya-agent enroll <cadena> --force"
msgstr "Die Registrierung dieses Agenten lag in einem ungeschützten Ordner (%(path)s) und ist nicht vertrauenswürdig: Sie wurde ungenutzt beiseitegelegt. Registrieren Sie den Rechner erneut: cenya-agent enroll <Zeichenfolge> --force"

#: agent/config.py:139
msgid "Este agente no está enrolado. En Ajustes → Agentes genera una cadena de conexión y ejecuta: cenya-agent enroll <cadena>"
msgstr "Dieser Agent ist nicht registriert. Unter Einstellungen → Agenten eine Verbindungszeichenfolge erzeugen und ausführen: cenya-agent enroll <Zeichenfolge>"

#: agent/connection.py:42
msgid "La cadena de conexión no es válida: debe parecerse a cenya://portal.midominio.com/XXXX-XXXX-XXXX. Cópiala entera de Ajustes → Agentes."
msgstr "Die Verbindungszeichenfolge ist ungültig: Sie muss etwa so aussehen: cenya://portal.meinefirma.de/XXXX-XXXX-XXXX. Vollständig aus Einstellungen → Agenten kopieren."

#: agent/control.py:375
#, python-format
msgid "El servidor ha rechazado este agente (%(error)s): no barre ni usa ninguna credencial hasta que lo acepte de nuevo, y le pregunta cada %(minutes)d minutos. Si se revocó, hay que enrolarlo otra vez."
msgstr "Der Server hat diesen Agenten abgelehnt (%(error)s): Er scannt nicht und verwendet keine Zugangsdaten, bis der Server ihn wieder akzeptiert, und fragt alle %(minutes)d Minuten nach. Wurde er widerrufen, muss er erneut registriert werden."

#: agent/control.py:381
#, python-format
msgid "La instalación de Cenya está en solo lectura (%(error)s): el agente no empieza ninguna tarea hasta que el servidor vuelva a aceptar resultados."
msgstr "Die Cenya-Installation ist schreibgeschützt (%(error)s): Der Agent startet keine Aufgabe, bis der Server wieder Ergebnisse annimmt."

#: agent/control.py:392
msgid "[agente] El servidor vuelve a aceptar a este agente."
msgstr "[Agent] Der Server akzeptiert diesen Agenten wieder."

#: agent/control.py:432
msgid "[agente] Configuración nueva recibida."
msgstr "[Agent] Neue Konfiguration empfangen."

#: agent/control.py:438
#, python-format
msgid "[agente] Hay una versión nueva del agente: %(version)s."
msgstr "[Agent] Eine neue Version des Agenten ist verfügbar: %(version)s."

#: agent/control.py:467
#, python-format
msgid "[agente] Encargo recibido: %(kind)s."
msgstr "[Agent] Auftrag erhalten: %(kind)s."

#: agent/enroll.py:71
msgid "El servidor no devolvió ningún token. ¿Es la dirección de un portal de Cenya?"
msgstr "Der Server hat kein Token zurückgegeben. Ist das die Adresse eines Cenya-Portals?"

#: agent/enroll.py:87
#, python-format
msgid "%(error)s El código ya se ha usado: genera otra cadena en Ajustes → Agentes."
msgstr "%(error)s Der Code wurde bereits verwendet: Unter Einstellungen → Agenten eine neue Zeichenfolge erzeugen."

#: agent/enroll.py:101
#, python-format
msgid "[agente] Enrolado como «%(name)s» en %(url)s."
msgstr "[Agent] Registriert als «%(name)s» bei %(url)s."

#: agent/enroll.py:130
#, python-format
msgid "Este equipo ya está enrolado como «%(name)s» en %(url)s. Para enrolarlo de nuevo, añade --force."
msgstr "Dieser Rechner ist bereits als «%(name)s» bei %(url)s registriert. Zum erneuten Registrieren --force anfügen."

#: agent/enroll.py:138
msgid "Cadena de conexión (la de Ajustes → Agentes): "
msgstr "Verbindungszeichenfolge (die aus Einstellungen → Agenten): "

#: agent/enroll.py:141
msgid "Falta la cadena de conexión: cenya-agent enroll cenya://portal.midominio.com/XXXX-XXXX-XXXX"
msgstr "Die Verbindungszeichenfolge fehlt: cenya-agent enroll cenya://portal.meinefirma.de/XXXX-XXXX-XXXX"

#: agent/enroll.py:149 agent/localops.py:862
msgid "El enrolamiento ha fallado."
msgstr "Die Registrierung ist fehlgeschlagen."

#: agent/enroll.py:151
#, python-format
msgid "Agente «%(name)s» enrolado en %(url)s."
msgstr "Agent «%(name)s» bei %(url)s registriert."

#: agent/enroll.py:152
#, python-format
msgid "El token queda guardado de forma protegida en %(path)s; no hace falta copiarlo."
msgstr "Das Token ist geschützt unter %(path)s gespeichert; es muss nicht kopiert werden."

#: agent/enroll.py:153
msgid "Para dejarlo funcionando, ejecuta: cenya-agent"
msgstr "Damit er dauerhaft läuft, ausführen: cenya-agent"

#: agent/goodbye.py:51 agent/localops.py:896
#, python-format
msgid "No se pudo avisar al servidor (%(error)s). El enrolamiento de este equipo se borra igualmente; el agente seguirá apareciendo en Ajustes → Agentes hasta que se borre allí."
msgstr "Der Server konnte nicht benachrichtigt werden (%(error)s). Die Registrierung dieses Rechners wird trotzdem gelöscht; der Agent erscheint weiterhin unter Einstellungen → Agenten, bis er dort gelöscht wird."

#: agent/goodbye.py:58
#, python-format
msgid "Se ha avisado al servidor (%(url)s): este agente queda dado de baja."
msgstr "Der Server (%(url)s) wurde benachrichtigt: Dieser Agent ist jetzt abgemeldet."

#: agent/goodbye.py:61
#, python-format
msgid "Borrado: %(path)s"
msgstr "Gelöscht: %(path)s"

#: agent/goodbye.py:63
#, python-format
msgid "No había enrolamiento que borrar en %(path)s."
msgstr "In %(path)s gab es keine Registrierung zu löschen."

#: agent/installer_text.py:35
msgid "Hace falta un PowerShell de administrador: instalar un servicio lo exige Windows."
msgstr "Dafür ist eine PowerShell mit Administratorrechten nötig: Windows verlangt sie zum Installieren eines Dienstes."

#: agent/installer_text.py:36
#, python-format
msgid "No se encuentra %(exe)s. ¿Está instalado el agente con el extra [windows] en %(dir)s?"
msgstr "%(exe)s ist nicht zu finden. Ist der Agent mit dem Extra [windows] in %(dir)s installiert?"

#: agent/installer_text.py:37
msgid "Cadena de conexión (Ajustes → Agentes → Añadir un agente)"
msgstr "Verbindungszeichenfolge (Einstellungen → Agenten → Agent hinzufügen)"

#: agent/installer_text.py:38
msgid "Sin enrolar el agente, el servicio no puede arrancar."
msgstr "Ohne Registrierung des Agenten kann der Dienst nicht starten."

#: agent/installer_text.py:39
msgid "El enrolamiento ha fallado: el motivo está justo encima."
msgstr "Die Registrierung ist fehlgeschlagen: Der Grund steht direkt darüber."

#: agent/installer_text.py:40
msgid "Con -Token hace falta también -Url."
msgstr "Zu -Token wird auch -Url benötigt."

#: agent/installer_text.py:41
msgid "Deteniendo el servicio para actualizarlo…"
msgstr "Dienst wird für die Aktualisierung angehalten…"

#: agent/installer_text.py:42
#, python-format
msgid "La instalación del servicio falló (código %(code)s)."
msgstr "Die Installation des Dienstes ist fehlgeschlagen (Code %(code)s)."

#: agent/installer_text.py:43
msgid "No se pudo configurar el reinicio automático (sc.exe failure)."
msgstr "Der automatische Neustart konnte nicht eingerichtet werden (sc.exe failure)."

#: agent/installer_text.py:44
#, python-format
msgid "No se encuentra %(tray)s: el icono de bandeja no se instala (¿agente anterior a esta versión?)."
msgstr "%(tray)s ist nicht zu finden: Das Symbol im Infobereich wird nicht installiert (Agent älter als diese Version?)."

#: agent/installer_text.py:45
#, python-format
msgid "El servicio no arrancó. Mira el Visor de eventos: Registros de Windows → Aplicación, origen %(source)s."
msgstr "Der Dienst ist nicht gestartet. Siehe Ereignisanzeige: Windows-Protokolle → Anwendung, Quelle %(source)s."

#: agent/installer_text.py:46
msgid "Servicio «Cenya Agent» instalado y en marcha."
msgstr "Dienst „Cenya Agent“ installiert und gestartet."

#: agent/installer_text.py:47
#, python-format
msgid "Sus mensajes van al Visor de eventos (Aplicación, origen %(source)s)."
msgstr "Seine Meldungen stehen in der Ereignisanzeige (Anwendung, Quelle %(source)s)."

#: agent/installer_text.py:48
#, python-format
msgid "Se gestiona desde services.msc, o con: %(exe)s stop | start | remove"
msgstr "Verwaltung über services.msc oder mit: %(exe)s stop | start | remove"

#: agent/installer_text.py:49
#, python-format
msgid "El icono de bandeja aparecerá al iniciar sesión. Para verlo ya: %(tray)s"
msgstr "Das Symbol im Infobereich erscheint bei der Anmeldung. Sofort anzeigen: %(tray)s"

#: agent/installer_text.py:51
msgid "Windows lo guarda al principio en el desplegable ^ de la barra de tareas: arrástralo fuera para tenerlo siempre a la vista."
msgstr "Windows legt es zunächst im Überlaufbereich ^ der Taskleiste ab: Zum dauerhaften Anzeigen herausziehen."

#: agent/localapi.py:153
msgid "La respuesta es demasiado grande para el canal local."
msgstr "Die Antwort ist zu groß für den lokalen Kanal."

#: agent/localapi.py:173
msgid "La petición no es JSON válido."
msgstr "Die Anfrage ist kein gültiges JSON."

#: agent/localapi.py:175
msgid "La petición tiene que ser un objeto JSON."
msgstr "Die Anfrage muss ein JSON-Objekt sein."

#: agent/localapi.py:178
msgid "El campo «id» tiene que ser un número o un texto."
msgstr "Das Feld „id“ muss eine Zahl oder ein Text sein."

#: agent/localapi.py:181
msgid "Falta el campo «op»."
msgstr "Das Feld „op“ fehlt."

#: agent/localapi.py:186
msgid "El campo «args» tiene que ser un objeto."
msgstr "Das Feld „args“ muss ein Objekt sein."

#: agent/localapi.py:212
#, python-format
msgid "Operación desconocida: %(op)s"
msgstr "Unbekannte Aktion: %(op)s"

#: agent/localapi.py:214
msgid "Esta operación solo la puede hacer un administrador."
msgstr "Diese Aktion darf nur ein Administrator ausführen."

#: agent/localapi.py:217
msgid "Este agente no sabe hacer todavía esa operación."
msgstr "Dieser Agent beherrscht diese Aktion noch nicht."

#: agent/localapi.py:225
#, python-format
msgid "[canal local] Fallo inesperado en %(op)s: %(type)s"
msgstr "[lokaler Kanal] Unerwarteter Fehler in %(op)s: %(type)s"

#: agent/localapi.py:226
#, python-format
msgid "Error inesperado en el agente (%(type)s)."
msgstr "Unerwarteter Fehler im Agenten (%(type)s)."

#: agent/localapi.py:371 agent/localpipe.py:399 agent/localpipe.py:593
msgid "Hay demasiadas conexiones abiertas con el agente."
msgstr "Es sind zu viele Verbindungen zum Agenten offen."

#: agent/localapi.py:376
msgid "La petición es demasiado grande."
msgstr "Die Anfrage ist zu groß."

#: agent/localclient.py:91
msgid "El servicio contestó algo que no se entiende."
msgstr "Der Dienst hat etwas Unverständliches geantwortet."

#: agent/localclient.py:110
msgid "El servicio cerró la conexión."
msgstr "Der Dienst hat die Verbindung geschlossen."

#: agent/localclient.py:113
msgid "La respuesta del servicio es demasiado grande."
msgstr "Die Antwort des Dienstes ist zu groß."

#: agent/localclient.py:136
msgid "Esta instalación no puede hablar con el servicio: falta pywin32."
msgstr "Diese Installation kann nicht mit dem Dienst sprechen: pywin32 fehlt."

#: agent/localclient.py:139
msgid "El canal del agente lo ha abierto otro programa, no el servicio de Cenya: no se le envía nada. Reinicia el servicio y avisa a quien administre este equipo."
msgstr "Der Kanal des Agenten wurde von einem anderen Programm geöffnet, nicht vom Cenya-Dienst: Es wird nichts gesendet. Starte den Dienst neu und informiere den Administrator dieses Computers."

#: agent/localclient.py:143
msgid "Esta cuenta no tiene permiso para hablar con el servicio del agente."
msgstr "Dieses Konto darf nicht mit dem Agentendienst sprechen."

#: agent/localclient.py:144
msgid "El servicio del agente no está en marcha en este equipo."
msgstr "Der Agentendienst läuft auf diesem Computer nicht."

#: agent/localclient.py:149
msgid "Esto solo lo puede hacer un administrador: abre la consola con «Ejecutar como administrador»."
msgstr "Das darf nur ein Administrator: Öffne die Konsole mit „Als Administrator ausführen“."

#: agent/localclient.py:150
msgid "Esto solo lo puede hacer root o la cuenta con la que corre el agente."
msgstr "Das darf nur root oder das Konto, unter dem der Agent läuft."

#: agent/localclient.py:155
#, python-format
msgid "Cenya Agent %(version)s"
msgstr "Cenya Agent %(version)s"

#: agent/localclient.py:157
msgid "No está conectado a ningún portal: cenya-agent connect <cadena>"
msgstr "Mit keinem Portal verbunden: cenya-agent connect <Zeichenfolge>"

#: agent/localclient.py:161
#, python-format
msgid "Conectado como «%(name)s» a %(portal)s (protocolo %(protocol)s)."
msgstr "Verbunden als „%(name)s“ mit %(portal)s (Protokoll %(protocol)s)."

#: agent/localclient.py:167
#, python-format
msgid "Conexión: correcta (último contacto a las %(clock)s)."
msgstr "Verbindung: in Ordnung (letzter Kontakt um %(clock)s)."

#: agent/localclient.py:169
#, python-format
msgid "Conexión: falla (%(error)s)."
msgstr "Verbindung: fehlerhaft (%(error)s)."

#: agent/localclient.py:171
msgid "Conexión: el servidor ha rechazado a este agente; hay que conectarlo de nuevo."
msgstr "Verbindung: Der Server hat diesen Agenten abgelehnt; er muss neu verbunden werden."

#: agent/localclient.py:173
msgid "Conexión: la instalación de Cenya está en solo lectura."
msgstr "Verbindung: Die Cenya-Installation ist schreibgeschützt."

#: agent/localclient.py:175
msgid "Conexión: todavía sin noticias del servidor."
msgstr "Verbindung: noch keine Antwort vom Server."

#: agent/localclient.py:184
#, python-format
msgid "Ahora: trabajando en %(task)s%(progress)s."
msgstr "Jetzt: arbeitet an %(task)s%(progress)s."

#: agent/localclient.py:186
#, python-format
msgid "Ahora: en pausa hasta las %(clock)s."
msgstr "Jetzt: pausiert bis %(clock)s."

#: agent/localclient.py:188
msgid "Ahora: esperando a la siguiente tarea."
msgstr "Jetzt: wartet auf die nächste Aufgabe."

#: agent/localclient.py:191
msgid "Tareas:"
msgstr "Aufgaben:"

#: agent/localclient.py:195
#, python-format
msgid "%(task)s: cada %(every)s, última %(last)s (%(status)s), próxima %(next)s"
msgstr "%(task)s: alle %(every)s, zuletzt %(last)s (%(status)s), nächste %(next)s"

#: agent/localclient.py:206
#, python-format
msgid "%(n)d envío pendiente en la cola local."
msgid_plural "%(n)d envíos pendientes en la cola local."
msgstr[0] "%(n)d Sendung wartet in der lokalen Warteschlange."
msgstr[1] "%(n)d Sendungen warten in der lokalen Warteschlange."

#: agent/localclient.py:209
#, python-format
msgid "Hay una versión nueva del agente: %(version)s."
msgstr "Eine neue Version des Agenten ist verfügbar: %(version)s."

#: agent/localclient.py:213
#, python-format
msgid "Exportando NetBox: %(step)s (%(done)s de %(total)s)."
msgstr "NetBox wird exportiert: %(step)s (%(done)s von %(total)s)."

#: agent/localclient.py:222
#, python-format
msgid "%(n)d hora"
msgid_plural "%(n)d horas"
msgstr[0] "%(n)d Stunde"
msgstr[1] "%(n)d Stunden"

#: agent/localclient.py:225
#, python-format
msgid "%(n)d minuto"
msgid_plural "%(n)d minutos"
msgstr[0] "%(n)d Minute"
msgstr[1] "%(n)d Minuten"

#: agent/localclient.py:226
#, python-format
msgid "%(n)d segundo"
msgid_plural "%(n)d segundos"
msgstr[0] "%(n)d Sekunde"
msgstr[1] "%(n)d Sekunden"

#: agent/localclient.py:230 agent/localclient.py:429
msgid "[bien]"
msgstr "[ok]"

#: agent/localclient.py:230 agent/localclient.py:429
msgid "[falla]"
msgstr "[Fehler]"

#: agent/localclient.py:239
msgid "Uso: cenya-agent status | run <tarea> | pause [--hours N] | resume | logs [-n N] [-f] | doctor | connect <cadena> | disconnect"
msgstr "Verwendung: cenya-agent status | run <Aufgabe> | pause [--hours N] | resume | logs [-n N] [-f] | doctor | connect <Zeichenfolge> | disconnect"

#: agent/localclient.py:287
msgid "El servicio no ha contestado a tiempo."
msgstr "Der Dienst hat nicht rechtzeitig geantwortet."

#: agent/localclient.py:290
msgid "Se ha perdido la conexión con el servicio."
msgstr "Die Verbindung zum Dienst ist verloren gegangen."

#: agent/localclient.py:313
#, python-format
msgid "Tarea %(task)s en cola: empieza en cuanto termine la que está en curso."
msgstr "Aufgabe %(task)s eingereiht: Sie beginnt, sobald die laufende fertig ist."

#: agent/localclient.py:315
msgid "Antes tiene que llegar la configuración del servidor."
msgstr "Zuerst muss die Konfiguration vom Server ankommen."

#: agent/localclient.py:317
msgid "La instalación de Cenya está en solo lectura: la tarea espera a que vuelva a aceptar resultados."
msgstr "Die Cenya-Installation ist schreibgeschützt: Die Aufgabe wartet, bis wieder Ergebnisse angenommen werden."

#: agent/localclient.py:336
#, python-format
msgid "Agente en pausa hasta las %(clock)s. La tarea en curso, si hay una, termina."
msgstr "Agent pausiert bis %(clock)s. Eine laufende Aufgabe wird noch beendet."

#: agent/localclient.py:345
msgid "Pausa local levantada."
msgstr "Lokale Pause aufgehoben."

#: agent/localclient.py:348
#, python-format
msgid "Sigue en pausa hasta las %(clock)s: esa pausa se puso desde la web y se quita allí."
msgstr "Weiterhin pausiert bis %(clock)s: Diese Pause wurde im Web gesetzt und wird dort aufgehoben."

#: agent/localclient.py:401
#, python-format
msgid "Tampoco se puede leer el registro (%(path)s) desde esta cuenta."
msgstr "Das Protokoll (%(path)s) kann von diesem Konto aus auch nicht gelesen werden."

#: agent/localclient.py:403
#, python-format
msgid "Registro leído directamente de %(path)s:"
msgstr "Protokoll direkt aus %(path)s gelesen:"

#: agent/localclient.py:421
msgid "Se prueba la conexión desde esta consola, sin el servicio."
msgstr "Die Verbindung wird von dieser Konsole aus getestet, ohne den Dienst."

#: agent/localclient.py:423
msgid "Conexión con el portal:"
msgstr "Verbindung zum Portal:"

#: agent/localclient.py:428
msgid "Esta instalación:"
msgstr "Diese Installation:"

#: agent/localclient.py:430
msgid "completa (colectores, librerías y traducciones)."
msgstr "vollständig (Kollektoren, Bibliotheken und Übersetzungen)."

#: agent/localclient.py:430
msgid "incompleta: detalle con cenya-agent selftest."
msgstr "unvollständig: Details mit cenya-agent selftest."

#: agent/localclient.py:468
msgid "Falta la cadena de conexión: cenya-agent connect cenya://portal.midominio.com/XXXX-XXXX-XXXX"
