msgstr "Version de l'agent : %(version)s"

#: agent/tray.py:178
#, python-format
msgid "Servidor: %(url)s"
msgstr "Serveur : %(url)s"

#: agent/tray.py:192
msgid "Ver estado"
msgstr "Voir l'état"

#: agent/tray.py:195
msgid "Abrir Ajustes → Agentes"
msgstr "Ouvrir Paramètres → Agents"

#: agent/tray.py:199
msgid "Cerrar este icono"
msgstr "Fermer cette icône"

#: agent/tray.py:272
#, python-format
msgid ""
"El icono de Cenya Agent no ha podido arrancar:\n"
"%(error)s"
msgstr ""
"L'icône de Cenya Agent n'a pas pu démarrer :\n"
"%(error)s"

#: agent/update.py:489
msgid "la firma del manifiesto no es de ninguna clave conocida"
msgstr "la signature du manifeste ne provient d'aucune clé connue"

#: agent/update.py:490
msgid "el fichero descargado no coincide con el manifiesto firmado; se ha borrado"
msgstr "le fichier téléchargé ne correspond pas au manifeste signé ; il a été supprimé"

#: agent/update.py:491
msgid "el manifiesto no es válido"
msgstr "le manifeste n'est pas valide"

#: agent/update.py:492
msgid "este agente no tiene ninguna clave de publicación configurada"
msgstr "cet agent n'a aucune clé de publication configurée"

#: agent/update.py:493
msgid "falta la librería cryptography para verificar la firma"
msgstr "la bibliothèque cryptography manque pour vérifier la signature"

#: agent/update.py:494
msgid "no es más nueva que la instalada"
msgstr "elle n'est pas plus récente que celle installée"

#: agent/update.py:495
msgid "el manifiesto es de otra versión"
msgstr "le manifeste concerne une autre version"

#: agent/update.py:496
msgid "no se pudo descargar"
msgstr "elle n'a pas pu être téléchargée"

#: agent/update.py:497
msgid "el instalador no llegó a sustituir el agente"
msgstr "le programme d'installation n'a pas remplacé l'agent"

#: agent/update.py:498
msgid "no consiguió conectar y se volvió a la versión anterior"
msgstr "elle n'a pas réussi à se connecter et la version précédente a été restaurée"

#: agent/update.py:499
msgid "este sistema no se actualiza solo"
msgstr "ce système ne se met pas à jour tout seul"

#: agent/update.py:609
#, python-format
msgid "[agente] Error inesperado al actualizar: %(error)s"
msgstr "[agent] Erreur inattendue lors de la mise à jour : %(error)s"

#: agent/update.py:645
#, python-format
msgid "[agente] La versión %(version)s no arrancó bien y se volvió a la anterior: no se intentará de nuevo."
msgstr "[agent] La version %(version)s n'a pas démarré correctement et la précédente a été restaurée : elle ne sera pas retentée."

#: agent/update.py:699
#, python-format
msgid "[agente] Hay una versión nueva del agente (%(version)s), pero la actualización automática está apagada en esta máquina."
msgstr "[agent] Une nouvelle version de l'agent est disponible (%(version)s), mais les mises à jour automatiques sont désactivées sur cette machine."

#: agent/update.py:731
#, python-format
msgid "[agente] Descargando la versión %(version)s del agente."
msgstr "[agent] Téléchargement de la version %(version)s de l'agent."

#: agent/update.py:741
#, python-format
msgid "[agente] Versión %(version)s verificada: se instalará en cuanto no haya ninguna tarea en curso."
msgstr "[agent] Version %(version)s vérifiée : elle sera installée dès qu'aucune tâche ne sera en cours."

#: agent/update.py:759
#, python-format
msgid "[agente] Instalando la versión %(version)s; el servicio se reiniciará."
msgstr "[agent] Installation de la version %(version)s ; le service va redémarrer."

#: agent/update.py:870
#, python-format
msgid "[agente] No se actualiza a la versión %(version)s: %(reason)s."
msgstr "[agent] Pas de mise à jour vers la version %(version)s : %(reason)s."

#: agent/update.py:1024
msgid "Uso: cenya-agent update apply-request <carpeta de estado>"
msgstr "Usage : cenya-agent update apply-request <dossier d'état>"

#: agent/winservice.py:163
msgid "El bucle del agente terminó sin que nadie lo parara."
msgstr "La boucle de l'agent s'est terminée sans que personne ne l'arrête."

#: agent/winservice.py:172
#, python-format
msgid "Cenya Agent se ha detenido: %(reason)s"
msgstr "Cenya Agent s'est arrêté : %(reason)s"

#: agent/winservice.py:213
#, python-format
msgid "No se encuentra %(dll)s: la Python con la que se creó este entorno ya no está donde estaba. Vuelve a crear el entorno virtual."
msgstr "%(dll)s introuvable : le Python qui a servi à créer cet environnement n'est plus à sa place. Recréer l'environnement virtuel."

#: agent/winservice.py:226
#, python-format
msgid "No se puede reemplazar %(file)s: detén el servicio antes de actualizarlo (%(command)s stop)."
msgstr "Impossible de remplacer %(file)s : arrêter le service avant de le mettre à jour (%(command)s stop)."

#: agent/winservice.py:314
msgid "Este equipo no está enrolado y en esta consola no hay ningún token: el servicio no podría arrancar. Ejecuta antes cenya-agent enroll <cadena> y vuelve a instalar."
msgstr "Cette machine n'est pas enrôlée et cette console ne contient aucun jeton : le service ne pourrait pas démarrer. Exécuter d'abord cenya-agent enroll <chaîne>, puis réinstaller."

#: agent/winservice.py:320
#, python-format
msgid "Variables guardadas en el servicio: %(names)s"
msgstr "Variables enregistrées dans le service : %(names)s"

#: agent/winservice.py:322
msgid "Sin variables CENYA_* en esta consola: se dejan las que ya tuviera el servicio."
msgstr "Aucune variable CENYA_* dans cette console : le service conserve celles qu'il avait déjà."

#: agent/winservice.py:324
msgid "La clave del servicio queda legible solo por SYSTEM y Administradores."
msgstr "La clé de registre du service n'est désormais lisible que par SYSTEM et les administrateurs."

#: agent/winservice.py:329
#, python-format
msgid "Estado del agente en %(path)s (lo escribe el servicio; lo lee el icono de bandeja)."
msgstr "État de l'agent dans %(path)s (écrit par le service, lu par l'icône de la zone de notification)."
