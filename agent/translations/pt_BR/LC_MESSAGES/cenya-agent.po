msgstr "Uso: cenya-agent status | run <tarefa> | pause [--hours N] | resume | logs [-n N] [-f] | doctor | connect <cadeia> | disconnect"

#: agent/localclient.py:562 agent/app/view.py:133
msgid "El servicio no ha contestado a tiempo."
msgstr "O serviço não respondeu a tempo."

#: agent/localclient.py:565
msgid "Se ha perdido la conexión con el servicio."
msgstr "A conexão com o serviço foi perdida."

#: agent/localclient.py:592
#, python-format
msgid "Tarea %(task)s en cola: empieza en cuanto termine la que está en curso."
msgstr "Tarefa %(task)s na fila: começa assim que terminar a que está em andamento."

#: agent/localclient.py:594
msgid "Antes tiene que llegar la configuración del servidor."
msgstr "Antes precisa chegar a configuração do servidor."

#: agent/localclient.py:596
msgid "La instalación de Cenya está en solo lectura: la tarea espera a que vuelva a aceptar resultados."
msgstr "A instalação do Cenya está somente leitura: a tarefa espera até que volte a aceitar resultados."

#: agent/localclient.py:615
#, python-format
msgid "Agente en pausa hasta las %(clock)s. La tarea en curso, si hay una, termina."
msgstr "Agente em pausa até %(clock)s. A tarefa em andamento, se houver, termina."

#: agent/localclient.py:624
msgid "Pausa local levantada."
msgstr "Pausa local retirada."

#: agent/localclient.py:627
#, python-format
msgid "Sigue en pausa hasta las %(clock)s: esa pausa se puso desde la web y se quita allí."
msgstr "Continua em pausa até %(clock)s: essa pausa foi definida na web e é retirada lá."

#: agent/localclient.py:681
#, python-format
msgid "Tampoco se puede leer el registro (%(path)s) desde esta cuenta."
msgstr "O registro (%(path)s) também não pode ser lido por esta conta."

#: agent/localclient.py:683
#, python-format
msgid "Registro leído directamente de %(path)s:"
msgstr "Registro lido diretamente de %(path)s:"

#: agent/localclient.py:703
msgid "Se prueba la conexión desde esta consola, sin el servicio."
msgstr "Testando a conexão a partir deste console, sem o serviço."

#: agent/localclient.py:705
