msgstr[0] "há %(n)d dia"
msgstr[1] "há %(n)d dias"

#: agent/status.py:321 agent/status.py:336
msgid "Agente detenido"
msgstr "Agente parado"

#: agent/status.py:321
msgid "El servicio está detenido y no hay datos de su última ejecución."
msgstr "O serviço está parado e não há dados da última execução."

#: agent/status.py:323
msgid "Servicio no instalado"
msgstr "Serviço não instalado"

#: agent/status.py:323
msgid "El servicio del agente no está instalado en este equipo."
msgstr "O serviço do agente não está instalado neste computador."

#: agent/status.py:324
msgid "Sin datos del agente"
msgstr "Sem dados do agente"

#: agent/status.py:324
msgid "No se encuentra el fichero de estado: el agente no ha arrancado nunca aquí, o no se puede leer."
msgstr "O arquivo de status não foi encontrado: o agente nunca foi iniciado aqui, ou o arquivo não pode ser lido."

#: agent/status.py:335
msgid "Agente detenido por un error"
msgstr "Agente parado por um erro"

#: agent/status.py:340
msgid "hace un tiempo desconocido"
msgstr "há um tempo desconhecido"

#: agent/status.py:343
msgid "Sin noticias del agente"
msgstr "Sem notícias do agente"

#: agent/status.py:345
#, python-format
msgid "La última noticia del agente es de %(ago)s: puede haberse detenido, o el fichero de estado ya no se actualiza."
msgstr "Última notícia do agente: %(ago)s. Ele pode ter parado, ou o arquivo de status não é mais atualizado."

#: agent/status.py:355
msgid "No puede hablar con el servidor"
msgstr "Sem conexão com o servidor"

#: agent/status.py:361
msgid "Barriendo la red"
msgstr "Varrendo a rede"

#: agent/status.py:362
#, python-format
msgid "Paso actual: %(step)s"
msgstr "Etapa atual: %(step)s"

#: agent/status.py:365
msgid "Arrancando"
msgstr "Iniciando"

#: agent/status.py:366
msgid "En marcha"
msgstr "Em execução"

#: agent/status.py:374
#, python-format
msgid "Cenya Agent: %(headline)s"
msgstr "Cenya Agent: %(headline)s"

#: agent/status.py:416
#, python-format
msgid "Último barrido: %(clock)s (%(ago)s)."
msgstr "Última varredura: %(clock)s (%(ago)s)."

#: agent/status.py:429
#, python-format
msgid "Salió parcial, con %(n)d aviso (detalle en Ajustes → Agentes)."
msgid_plural "Salió parcial, con %(n)d avisos (detalle en Ajustes → Agentes)."
msgstr[0] "Saiu parcial, com %(n)d aviso (detalhes em Configurações → Agentes)."
msgstr[1] "Saiu parcial, com %(n)d avisos (detalhes em Configurações → Agentes)."

#: agent/status.py:436
msgid "Todavía no ha terminado ningún barrido."
msgstr "Ainda nenhuma varredura terminou."

#: agent/status.py:439
#, python-format
msgid "Próximo barrido hacia las %(clock)s."
msgstr "Próxima varredura por volta das %(clock)s."

#: agent/store.py:132
#, python-format
msgid "No se pudo guardar el enrolamiento de forma segura en %(path)s: %(error)s"
msgstr "Não foi possível salvar o registro de forma segura em %(path)s: %(error)s"

#: agent/tray.py:175
#, python-format
msgid "Versión del agente: %(version)s"
msgstr "Versão do agente: %(version)s"

#: agent/tray.py:178
#, python-format
msgid "Servidor: %(url)s"
msgstr "Servidor: %(url)s"

#: agent/tray.py:192
msgid "Ver estado"
msgstr "Ver status"

#: agent/tray.py:195
msgid "Abrir Ajustes → Agentes"
msgstr "Abrir Configurações → Agentes"

#: agent/tray.py:199
msgid "Cerrar este icono"
msgstr "Fechar este ícone"

#: agent/tray.py:272
#, python-format
msgid ""
"El icono de Cenya Agent no ha podido arrancar:\n"
"%(error)s"
msgstr ""
"O ícone do Cenya Agent não conseguiu iniciar:\n"
"%(error)s"

#: agent/winservice.py:161
msgid "El bucle del agente terminó sin que nadie lo parara."
msgstr "O loop do agente terminou sem que ninguém o parasse."

#: agent/winservice.py:170
#, python-format
msgid "Cenya Agent se ha detenido: %(reason)s"
msgstr "O Cenya Agent parou: %(reason)s"

#: agent/winservice.py:211
#, python-format
msgid "No se encuentra %(dll)s: la Python con la que se creó este entorno ya no está donde estaba. Vuelve a crear el entorno virtual."
msgstr "%(dll)s não foi encontrado: o Python com que este ambiente foi criado não está mais onde estava. Crie o ambiente virtual de novo."

#: agent/winservice.py:224
#, python-format
msgid "No se puede reemplazar %(file)s: detén el servicio antes de actualizarlo (%(command)s stop)."
msgstr "Não é possível substituir %(file)s: pare o serviço antes de atualizá-lo (%(command)s stop)."

#: agent/winservice.py:321
msgid "Este equipo no está enrolado y en esta consola no hay ningún token: el servicio no podría arrancar. Ejecuta antes cenya-agent enroll <cadena> y vuelve a instalar."
msgstr "Esta máquina não está registrada e não há nenhum token neste console: o serviço não conseguiria iniciar. Execute antes cenya-agent enroll <cadeia> e instale de novo."

#: agent/winservice.py:327
#, python-format
msgid "Variables guardadas en el servicio: %(names)s"
msgstr "Variáveis salvas no serviço: %(names)s"

#: agent/winservice.py:329
msgid "Sin variables CENYA_* en esta consola: se dejan las que ya tuviera el servicio."
msgstr "Sem variáveis CENYA_* neste console: ficam as que o serviço já tinha."

#: agent/winservice.py:331
msgid "La clave del servicio queda legible solo por SYSTEM y Administradores."
msgstr "A chave de registro do serviço agora só pode ser lida por SYSTEM e Administradores."

#: agent/winservice.py:336
#, python-format
msgid "Estado del agente en %(path)s (lo escribe el servicio; lo lee el icono de bandeja)."
msgstr "Status do agente em %(path)s (gravado pelo serviço, lido pelo ícone da bandeja)."
