msgstr "[agente] %(error)s"

#: agent/__main__.py:325
msgid "[agente] Detenido."
msgstr "[agente] Parado."

#: agent/__main__.py:350
msgid "[agente] Sin enrolar: esperando una conexión."
msgstr "[agente] Não registrado: aguardando uma conexão."

#: agent/__main__.py:351
msgid "[agente] Esperando a que se conecte este equipo (cenya-agent connect <cadena>, o la aplicación Cenya Agent)."
msgstr "[agente] Aguardando que esta máquina seja conectada (cenya-agent connect <cadeia>, ou o aplicativo Cenya Agent)."

#: agent/__main__.py:384
#, python-format
msgid "[agente] Conectado a %(url)s con el protocolo 2."
msgstr "[agente] Conectado a %(url)s com o protocolo 2."

#: agent/__main__.py:388
msgid "[agente] El servidor solo habla el protocolo 1: se sigue con el bucle de siempre."
msgstr "[agente] O servidor só fala o protocolo 1: segue-se com o ciclo de sempre."

#: agent/__main__.py:403
#, python-format
msgid "[agente] Empujando a %(url)s cada ~%(seconds)d s."
msgstr "[agente] Enviando para %(url)s a cada ~%(seconds)d s."

#: agent/approvals.py:142
#, python-format
msgid "[agente] El agente «%(name)s» pide las credenciales de este perfil: hay que permitirlo o rechazarlo en la ventana de Cenya Agent de este equipo."
msgstr "[agente] O agente \"%(name)s\" está pedindo as credenciais deste perfil: permita ou recuse na janela do Cenya Agent desta máquina."

#: agent/client.py:167
msgid "La dirección del proxy no es válida: revisa el ajuste «proxy» (settings.json o CENYA_PROXY). No se muestra aquí porque puede llevar una contraseña."
msgstr "O endereço do proxy não é válido: verifique a configuração «proxy» (settings.json ou CENYA_PROXY). Ele não é mostrado aqui porque pode conter uma senha."

#: agent/client.py:404
#, python-format
msgid "Lo leído de NetBox ocupa %(mb)s MB y el servidor admite %(max)s MB como mucho."
msgstr "O que foi lido do NetBox ocupa %(mb)s MB e o servidor aceita no máximo %(max)s MB."

#: agent/client.py:450
#, python-format
msgid "El servidor respondió %(code)s: %(detail)s"
msgstr "O servidor respondeu %(code)s: %(detail)s"

#: agent/client.py:454 agent/client.py:460
#, python-format
msgid "No se pudo hablar con el servidor: %(error)s"
msgstr "Não foi possível falar com o servidor: %(error)s"

#: agent/client.py:465
msgid "El servidor respondió algo que no es un objeto JSON."
msgstr "O servidor respondeu algo que não é um objeto JSON."

#: agent/config.py:55
#, python-format
msgid "La dirección del portal es http:// hacia %(host)s: el latido lleva las credenciales de descubrimiento y viajarían en claro. Usa https:// (con CENYA_CA_BUNDLE si el certificado es propio) o, solo para pruebas, CENYA_INSECURE_HTTP=1."
msgstr "O endereço do portal é http:// para %(host)s: o batimento leva as credenciais de descoberta, que trafegariam sem criptografia. Use https:// (com CENYA_CA_BUNDLE se o certificado for próprio) ou, só para testes, CENYA_INSECURE_HTTP=1."

#: agent/config.py:130
#, python-format
msgid "El enrolamiento de este agente estaba en una carpeta sin proteger (%(path)s) y no es de fiar: se ha apartado sin usarlo. Enrola el equipo de nuevo: cenya-agent enroll <cadena> --force"
msgstr "O registro deste agente estava em uma pasta desprotegida (%(path)s) e não é confiável: foi deixado de lado sem ser usado. Registre esta máquina novamente: cenya-agent enroll <cadeia> --force"

#: agent/config.py:139
msgid "Este agente no está enrolado. En Ajustes → Agentes genera una cadena de conexión y ejecuta: cenya-agent enroll <cadena>"
msgstr "Este agente não está registrado. Em Configurações → Agentes, gere uma cadeia de conexão e execute: cenya-agent enroll <cadeia>"

#: agent/connection.py:42
msgid "La cadena de conexión no es válida: debe parecerse a cenya://portal.midominio.com/XXXX-XXXX-XXXX. Cópiala entera de Ajustes → Agentes."
msgstr "A cadeia de conexão não é válida: deve se parecer com cenya://portal.minhaempresa.com.br/XXXX-XXXX-XXXX. Copie-a inteira de Configurações → Agentes."

#: agent/control.py:401
#, python-format
msgid "El servidor ha rechazado este agente (%(error)s): no barre ni usa ninguna credencial hasta que lo acepte de nuevo, y le pregunta cada %(minutes)d minutos. Si se revocó, hay que enrolarlo otra vez."
msgstr "O servidor rejeitou este agente (%(error)s): ele não faz varreduras nem usa nenhuma credencial até que o servidor o aceite de novo, e pergunta a cada %(minutes)d minutos. Se foi revogado, é preciso registrá-lo novamente."

#: agent/control.py:407
#, python-format
msgid "La instalación de Cenya está en solo lectura (%(error)s): el agente no empieza ninguna tarea hasta que el servidor vuelva a aceptar resultados."
msgstr "A instalação do Cenya está somente leitura (%(error)s): o agente não inicia nenhuma tarefa até que o servidor volte a aceitar resultados."

#: agent/control.py:418
msgid "[agente] El servidor vuelve a aceptar a este agente."
msgstr "[agente] O servidor voltou a aceitar este agente."

#: agent/control.py:446
msgid "[agente] El portal guarda otra clave para este agente: no podrá abrir las credenciales selladas. Enrólalo de nuevo (cenya-agent enroll <cadena> --force)."
msgstr "[agente] O portal guarda outra chave para este agente: ele não poderá abrir as credenciais seladas. Registre-o de novo (cenya-agent enroll <cadeia> --force)."

#: agent/control.py:481
msgid "[agente] Configuración nueva recibida."
msgstr "[agente] Nova configuração recebida."

#: agent/control.py:487
#, python-format
msgid "[agente] Hay una versión nueva del agente: %(version)s."
msgstr "[agente] Há uma nova versão do agente: %(version)s."

#: agent/control.py:516
#, python-format
msgid "[agente] Encargo recibido: %(kind)s."
msgstr "[agente] Pedido recebido: %(kind)s."

#: agent/enroll.py:71
msgid "El servidor no devolvió ningún token. ¿Es la dirección de un portal de Cenya?"
msgstr "O servidor não devolveu nenhum token. É o endereço de um portal Cenya?"

#: agent/enroll.py:87
#, python-format
msgid "%(error)s El código ya se ha usado: genera otra cadena en Ajustes → Agentes."
msgstr "%(error)s O código já foi usado: gere outra cadeia em Configurações → Agentes."

#: agent/enroll.py:101
#, python-format
msgid "[agente] Enrolado como «%(name)s» en %(url)s."
msgstr "[agente] Registrado como «%(name)s» em %(url)s."

#: agent/enroll.py:130
#, python-format
msgid "Este equipo ya está enrolado como «%(name)s» en %(url)s. Para enrolarlo de nuevo, añade --force."
msgstr "Esta máquina já está registrada como «%(name)s» em %(url)s. Para registrá-la de novo, adicione --force."

#: agent/enroll.py:138
msgid "Cadena de conexión (la de Ajustes → Agentes): "
msgstr "Cadeia de conexão (a de Configurações → Agentes): "

#: agent/enroll.py:141
msgid "Falta la cadena de conexión: cenya-agent enroll cenya://portal.midominio.com/XXXX-XXXX-XXXX"
msgstr "Falta a cadeia de conexão: cenya-agent enroll cenya://portal.minhaempresa.com.br/XXXX-XXXX-XXXX"

#: agent/enroll.py:149 agent/localops.py:929
msgid "El enrolamiento ha fallado."
msgstr "O registro falhou."

#: agent/enroll.py:151
#, python-format
msgid "Agente «%(name)s» enrolado en %(url)s."
msgstr "Agente «%(name)s» registrado em %(url)s."

#: agent/enroll.py:152
#, python-format
msgid "El token queda guardado de forma protegida en %(path)s; no hace falta copiarlo."
msgstr "O token fica guardado de forma protegida em %(path)s; não é preciso copiá-lo."

#: agent/enroll.py:153
msgid "Para dejarlo funcionando, ejecuta: cenya-agent"
msgstr "Para deixá-lo em funcionamento, execute: cenya-agent"

#: agent/goodbye.py:51 agent/localops.py:963
#, python-format
msgid "No se pudo avisar al servidor (%(error)s). El enrolamiento de este equipo se borra igualmente; el agente seguirá apareciendo en Ajustes → Agentes hasta que se borre allí."
msgstr "Não foi possível avisar o servidor (%(error)s). O registro desta máquina é apagado mesmo assim; o agente continuará aparecendo em Configurações → Agentes até ser excluído lá."

#: agent/goodbye.py:58
#, python-format
msgid "Se ha avisado al servidor (%(url)s): este agente queda dado de baja."
msgstr "O servidor (%(url)s) foi avisado: este agente foi desativado."

#: agent/goodbye.py:61
#, python-format
msgid "Borrado: %(path)s"
msgstr "Apagado: %(path)s"

#: agent/goodbye.py:63
#, python-format
msgid "No había enrolamiento que borrar en %(path)s."
msgstr "Não havia registro para apagar em %(path)s."

#: agent/installer_text.py:35
msgid "Hace falta un PowerShell de administrador: instalar un servicio lo exige Windows."
msgstr "É preciso um PowerShell de administrador: o Windows exige isso para instalar um serviço."

#: agent/installer_text.py:36
#, python-format
msgid "No se encuentra %(exe)s. ¿Está instalado el agente con el extra [windows] en %(dir)s?"
msgstr "%(exe)s não foi encontrado. O agente está instalado com o extra [windows] em %(dir)s?"

#: agent/installer_text.py:37
msgid "Cadena de conexión (Ajustes → Agentes → Añadir un agente)"
msgstr "Cadeia de conexão (Configurações → Agentes → Adicionar um agente)"

#: agent/installer_text.py:38
msgid "Sin enrolar el agente, el servicio no puede arrancar."
msgstr "Sem registrar o agente, o serviço não pode iniciar."

#: agent/installer_text.py:39
msgid "El enrolamiento ha fallado: el motivo está justo encima."
msgstr "O registro falhou: o motivo está logo acima."

#: agent/installer_text.py:40
msgid "Con -Token hace falta también -Url."
msgstr "Com -Token também é preciso -Url."

#: agent/installer_text.py:41
msgid "Deteniendo el servicio para actualizarlo…"
msgstr "Parando o serviço para atualizá-lo…"

#: agent/installer_text.py:42
#, python-format
msgid "La instalación del servicio falló (código %(code)s)."
msgstr "A instalação do serviço falhou (código %(code)s)."

#: agent/installer_text.py:43
msgid "No se pudo configurar el reinicio automático (sc.exe failure)."
msgstr "Não foi possível configurar a reinicialização automática (sc.exe failure)."

#: agent/installer_text.py:44
#, python-format
msgid "No se encuentra %(tray)s: el icono de bandeja no se instala (¿agente anterior a esta versión?)."
msgstr "%(tray)s não foi encontrado: o ícone da bandeja não será instalado (agente anterior a esta versão?)."

#: agent/installer_text.py:45
#, python-format
msgid "El servicio no arrancó. Mira el Visor de eventos: Registros de Windows → Aplicación, origen %(source)s."
msgstr "O serviço não iniciou. Veja o Visualizador de Eventos: Logs do Windows → Aplicativo, fonte %(source)s."

#: agent/installer_text.py:46
msgid "Servicio «Cenya Agent» instalado y en marcha."
msgstr "Serviço “Cenya Agent” instalado e em execução."

#: agent/installer_text.py:47
#, python-format
msgid "Sus mensajes van al Visor de eventos (Aplicación, origen %(source)s)."
msgstr "As mensagens dele vão para o Visualizador de Eventos (Aplicativo, fonte %(source)s)."

#: agent/installer_text.py:48
#, python-format
msgid "Se gestiona desde services.msc, o con: %(exe)s stop | start | remove"
msgstr "Gerencie pelo services.msc, ou com: %(exe)s stop | start | remove"

#: agent/installer_text.py:49
#, python-format
msgid "El icono de bandeja aparecerá al iniciar sesión. Para verlo ya: %(tray)s"
msgstr "O ícone da bandeja aparecerá ao entrar na sessão. Para vê-lo agora: %(tray)s"

#: agent/installer_text.py:51
msgid "Windows lo guarda al principio en el desplegable ^ de la barra de tareas: arrástralo fuera para tenerlo siempre a la vista."
msgstr "O Windows o guarda primeiro no menu ^ da barra de tarefas: arraste-o para fora para deixá-lo sempre à vista."

#: agent/localapi.py:158
msgid "La respuesta es demasiado grande para el canal local."
msgstr "A resposta é grande demais para o canal local."

#: agent/localapi.py:178
msgid "La petición no es JSON válido."
msgstr "A solicitação não é um JSON válido."

#: agent/localapi.py:180
msgid "La petición tiene que ser un objeto JSON."
msgstr "A solicitação precisa ser um objeto JSON."

#: agent/localapi.py:183
msgid "El campo «id» tiene que ser un número o un texto."
msgstr "O campo “id” precisa ser um número ou um texto."

#: agent/localapi.py:186
msgid "Falta el campo «op»."
msgstr "Falta o campo “op”."

#: agent/localapi.py:191
msgid "El campo «args» tiene que ser un objeto."
msgstr "O campo “args” precisa ser um objeto."

#: agent/localapi.py:217
#, python-format
msgid "Operación desconocida: %(op)s"
msgstr "Operação desconhecida: %(op)s"

#: agent/localapi.py:219
msgid "Esta operación solo la puede hacer un administrador."
msgstr "Só um administrador pode fazer esta operação."

#: agent/localapi.py:222
msgid "Este agente no sabe hacer todavía esa operación."
msgstr "Este agente ainda não sabe fazer essa operação."

#: agent/localapi.py:230
#, python-format
msgid "[canal local] Fallo inesperado en %(op)s: %(type)s"
msgstr "[canal local] Falha inesperada em %(op)s: %(type)s"

#: agent/localapi.py:231
#, python-format
msgid "Error inesperado en el agente (%(type)s)."
msgstr "Erro inesperado no agente (%(type)s)."

#: agent/localapi.py:377 agent/localpipe.py:407 agent/localpipe.py:619
msgid "Hay demasiadas conexiones abiertas con el agente."
msgstr "Há conexões demais abertas com o agente."

#: agent/localapi.py:382
msgid "La petición es demasiado grande."
msgstr "A solicitação é grande demais."

#: agent/localclient.py:392
msgid "Esta instalación no puede hablar con el servicio: falta pywin32."
msgstr "Esta instalação não consegue falar com o serviço: falta o pywin32."

#: agent/localclient.py:395
msgid "El canal del agente lo ha abierto otro programa, no el servicio de Cenya: no se le envía nada. Reinicia el servicio y avisa a quien administre este equipo."
msgstr "O canal do agente foi aberto por outro programa, não pelo serviço do Cenya: nada é enviado a ele. Reinicie o serviço e avise quem administra este computador."

#: agent/localclient.py:399
msgid "Esta cuenta no tiene permiso para hablar con el servicio del agente."
msgstr "Esta conta não tem permissão para falar com o serviço do agente."

#: agent/localclient.py:400
msgid "El servicio del agente no está en marcha en este equipo."
msgstr "O serviço do agente não está em execução neste computador."

#: agent/localclient.py:405
msgid "Esto solo lo puede hacer un administrador: abre la consola con «Ejecutar como administrador»."
msgstr "Só um administrador pode fazer isso: abra o console com “Executar como administrador”."

#: agent/localclient.py:406
msgid "Esto solo lo puede hacer root o la cuenta con la que corre el agente."
msgstr "Só o root ou a conta em que o agente roda pode fazer isso."

#: agent/localclient.py:411
#, python-format
msgid "Cenya Agent %(version)s"
msgstr "Cenya Agent %(version)s"

#: agent/localclient.py:416
msgid "No está conectado a ningún portal: cenya-agent connect <cadena>"
msgstr "Não está conectado a nenhum portal: cenya-agent connect <cadeia>"

#: agent/localclient.py:420
#, python-format
msgid "Conectado como «%(name)s» a %(portal)s (protocolo %(protocol)s)."
msgstr "Conectado como “%(name)s” a %(portal)s (protocolo %(protocol)s)."

#: agent/localclient.py:426
#, python-format
msgid "Conexión: correcta (último contacto a las %(clock)s)."
msgstr "Conexão: correta (último contato às %(clock)s)."

#: agent/localclient.py:428
#, python-format
msgid "Conexión: falla (%(error)s)."
msgstr "Conexão: com falha (%(error)s)."

#: agent/localclient.py:430
msgid "Conexión: el servidor ha rechazado a este agente; hay que conectarlo de nuevo."
msgstr "Conexão: o servidor rejeitou este agente; é preciso conectá-lo de novo."

#: agent/localclient.py:432
msgid "Conexión: la instalación de Cenya está en solo lectura."
msgstr "Conexão: a instalação do Cenya está somente leitura."

#: agent/localclient.py:434
msgid "Conexión: todavía sin noticias del servidor."
msgstr "Conexão: ainda sem notícias do servidor."

#: agent/localclient.py:443
#, python-format
msgid "Ahora: trabajando en %(task)s%(progress)s."
msgstr "Agora: trabalhando em %(task)s%(progress)s."

#: agent/localclient.py:445
msgid "Ahora: en pausa hasta que se reanude (cenya-agent resume)."
msgstr "Agora: em pausa até ser retomado (cenya-agent resume)."

#: agent/localclient.py:447
#, python-format
msgid "Ahora: en pausa hasta las %(clock)s."
msgstr "Agora: em pausa até %(clock)s."

#: agent/localclient.py:449
msgid "Ahora: esperando a la siguiente tarea."
msgstr "Agora: aguardando a próxima tarefa."

#: agent/localclient.py:452
